---
import SectionHeader from '../common/SectionHeader.astro';
import PrincipleCard from './PrincipleCard.astro';

const principles = [
  {
    num: "01",
    title: "AUTOMATE",
    category: "GITOPS & WORKFLOWS",
    statement: "If a task happens repeatedly, it should be automated.",
    explanation: "Manual actions introduce variance and human error into production. Automation turns infrastructure knowledge into version-controlled, auditable code.",
    rule: "policy: zero_manual_drift",
    impact: "100% reproducible environments"
  },
  {
    num: "02",
    title: "OBSERVE",
    category: "RELIABILITY & TELEMETRY",
    statement: "You cannot fix what you cannot measure.",
    explanation: "Reliability requires deep observability into saturation, latencies, and anomalies. Telemetry must be active before incidents occur.",
    rule: "telemetry: metrics_logs_traces",
    impact: "Sub-second anomaly triage"
  },
  {
    num: "03",
    title: "DESIGN FOR FAILURE",
    category: "DISTRIBUTED SYSTEMS",
    statement: "Assume every component will fail at the worst time.",
    explanation: "Nodes crash, disks corrupt, networks partition. High availability is achieved by architecting automated consensus, leader elections, and recovery loops.",
    rule: "topology: multi_az_redundant",
    impact: "Zero single points of failure"
  },
  {
    num: "04",
    title: "SECURITY BY DEFAULT",
    category: "DEVSECOPS PIPELINE",
    statement: "Security belongs in the pipeline, not as an afterthought.",
    explanation: "Vulnerability gating, secret segregation, minimal container base images, and least-privilege firewalls must be integral to every deployment.",
    rule: "pipeline: shift_left_scanning",
    impact: "Zero unverified production assets"
  },
  {
    num: "05",
    title: "KEEP IT SIMPLE",
    category: "OPERATIONAL COMPLEXITY",
    statement: "Complexity is an operational tax. Prefer boring technology.",
    explanation: "Proven, mature tools with predictable failure characteristics will always outperform bloated frameworks when troubleshooting outages at 3 AM.",
    rule: "stack: boring_and_proven",
    impact: "Minimal cognitive load during incidents"
  }
];
---

<section id="mindset" class="mindset-section">
  <div class="container">
    <SectionHeader
      eyebrow="07 // OPERATIONAL CULTURE"
      title="ENGINEERING MINDSET"
      description="The foundational axioms that guide architectural decisions, deployment pipelines, and disaster recovery strategies."
    />

    <!-- Matrix Control Strip / Header Info -->
    <div class="matrix-control-strip font-mono text-xs" data-reveal>
      <div class="control-item">
        <span class="control-label">FRAMEWORK:</span>
        <span class="control-val">OPERATIONAL AXIOMS MATRIX</span>
      </div>
      <div class="control-item">
        <span class="control-label">STATUS:</span>
        <span class="control-val text-success">
          <span class="pulse-indicator" aria-hidden="true"></span>
          5/5 ENFORCED
        </span>
      </div>
      <div class="control-item hide-mobile">
        <span class="control-label">TARGET:</span>
        <span class="control-val">RELIABLE & IMMUTABLE INFRASTRUCTURE</span>
      </div>
    </div>

    <!-- The Clean Operational Matrix Container -->
    <div class="principles-matrix" role="region" aria-label="Engineering Mindset Operational Matrix">
      {principles.map((p, index) => (
        <PrincipleCard
          num={p.num}
          title={p.title}
          category={p.category}
          statement={p.statement}
          explanation={p.explanation}
          rule={p.rule}
          impact={p.impact}
          delay={index * 80}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .mindset-section {
    padding: clamp(var(--space-16), 8vw, var(--space-24)) 0;
    position: relative;
    background: transparent;
  }

  /* Matrix Top Meta Bar */
  .matrix-control-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: rgba(16, 26, 38, 0.4);
    border: 1px solid var(--color-border);
    border-bottom: none;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .control-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .control-label {
    color: var(--color-text-muted);
    font-weight: 700;
  }

  .control-val {
    color: var(--color-text-primary);
  }

  .text-success {
    color: var(--color-success);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
  }

  .pulse-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 6px var(--color-success);
  }

  /* Matrix Rows Container */
  .principles-matrix {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    background: var(--color-bg-1);
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .hide-mobile {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .matrix-control-strip {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      padding: var(--space-3);
    }
  }
</style>
