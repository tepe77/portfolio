---
import SectionHeader from '../common/SectionHeader.astro';
import Button from '../common/Button.astro';
import Icon from '../common/Icon.astro';
import SocialLinks from './SocialLinks.astro';
import { profileData } from '../../data/profile';
---

<section id="contact" class="contact-section">
  <div class="container">
    <SectionHeader
      eyebrow="08 // INITIATE TRANSMISSION"
      title="LET'S BUILD RELIABLE SYSTEMS"
      description="Interested in infrastructure engineering, CI/CD automation, database clustering, or operational reliability? Let's connect."
      align="center"
    />

    <div class="contact-wrapper" data-reveal>
      <!-- Terminal Contact Card -->
      <div class="contact-terminal font-mono">
        <div class="ct-header">
          <span class="ct-prompt">prasaswo@portfolio:~$</span>
          <span class="ct-cmd">ssh connect@prasaswo.dev</span>
        </div>
        <div class="ct-output">
          <p>SSH-2.0-OpenSSH_9.2p1 Debian-2+deb12u2</p>
          <p class="text-green">Connection established with 256-bit elliptic curve encryption.</p>
          <p class="text-muted">Direct messaging channel open. Ready for collaboration or inquiries.</p>
        </div>
      </div>

      <!-- Primary Action Buttons -->
      <div class="contact-cta-bar">
        <Button href={`mailto:${profileData.email}`} variant="primary" size="lg">
          <Icon name="external-link" size={18} />
          <span>EMAIL ME DIRECTLY</span>
        </Button>

        <button
          type="button"
          id="copy-email-btn"
          class="btn-copy-email font-mono"
          data-email={profileData.email}
          aria-label="Copy email address to clipboard"
        >
          <Icon name="copy" size={18} />
          <span id="copy-email-text">COPY EMAIL</span>
        </button>

        <Button href={profileData.resumeUrl} variant="secondary" size="lg" download="prasaswo-tepe-resume.pdf">
          <Icon name="download" size={18} />
          <span>DOWNLOAD RESUME</span>
        </Button>
      </div>

      <!-- Social Links Grid -->
      <SocialLinks />
    </div>
  </div>
</section>

<style>
  .contact-wrapper {
    max-width: 800px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .contact-terminal {
    background: var(--color-bg-0);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .ct-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid rgba(27, 48, 66, 0.4);
  }

  .ct-prompt {
    color: var(--color-accent-primary);
    font-weight: 700;
  }

  .ct-cmd {
    color: var(--color-text-primary);
  }

  .ct-output {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .ct-output p {
    margin-bottom: 0;
  }

  .contact-cta-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .btn-copy-email {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    transition: all var(--duration-fast);
    outline: none;
    user-select: none;
    min-height: 48px;
  }

  .btn-copy-email:hover {
    background: var(--color-surface-2);
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    box-shadow: 0 0 16px rgba(25, 211, 230, 0.2);
  }

  .btn-copy-email.copied {
    background: rgba(32, 211, 155, 0.15);
    border-color: var(--color-success);
    color: var(--color-success);
    box-shadow: 0 0 16px rgba(32, 211, 155, 0.3);
  }

  @media (max-width: 640px) {
    .contact-cta-bar {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<script>
  function initCopyEmail() {
    const btn = document.getElementById('copy-email-btn');
    const text = document.getElementById('copy-email-text');
    if (!btn || !text) return;

    btn.addEventListener('click', async () => {
      const email = btn.dataset.email || 'prasaswo@gmail.com';
      try {
        await navigator.clipboard.writeText(email);
        text.textContent = 'COPIED TO CLIPBOARD!';
        btn.classList.add('copied');
        setTimeout(() => {
          text.textContent = 'COPY EMAIL';
          btn.classList.remove('copied');
        }, 2500);
      } catch {
        // Fallback for browsers with strict clipboard permissions
        text.textContent = email;
      }
    });
  }

  initCopyEmail();
  document.addEventListener('astro:page-load', initCopyEmail);
</script>
