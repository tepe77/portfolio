---
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = "left",
  class: className = ""
} = Astro.props;
---

<header class={`section-header align-${align} ${className}`} data-reveal>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2 class="section-title">{title}</h2>
  {description && <p class="section-description">{description}</p>}
  <div class="header-line" aria-hidden="true"></div>
</header>

<style>
  .section-header {
    margin-bottom: var(--space-12);
    position: relative;
  }

  .align-left {
    text-align: left;
  }

  .align-center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .section-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 680px;
    margin-bottom: var(--space-4);
    line-height: 1.6;
  }

  .header-line {
    width: 64px;
    height: 3px;
    background: linear-gradient(to right, var(--color-accent-primary), transparent);
    border-radius: var(--radius-pill);
  }

  .align-center .header-line {
    background: linear-gradient(to right, transparent, var(--color-accent-primary), transparent);
  }
</style>
