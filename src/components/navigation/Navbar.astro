---
import Icon from '../common/Icon.astro';
import StatusBadge from '../common/StatusBadge.astro';

const navLinks = [
  { label: "ABOUT", href: "#about" },
  { label: "INFRASTRUCTURE", href: "#infrastructure" },
  { label: "PROJECTS", href: "#projects" },
  { label: "PIPELINES", href: "#pipeline" },
  { label: "STACK", href: "#stack" },
  { label: "EXPERIENCE", href: "#experience" },
  { label: "CONTACT", href: "#contact" }
];
---

<header id="main-navbar" class="navbar">
  <div class="container navbar-container">
    <!-- Brand Logo -->
    <a href="#" class="brand-logo" aria-label="Prasaswo Tepe Portfolio Home">
      <span class="brand-bracket font-mono">&lt;&gt;</span>
      <span class="brand-name font-mono">PRASASWO.TEPE</span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="nav-link font-mono">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right Controls: Status & Cmd+K & Mobile Toggle -->
    <div class="navbar-actions">
      <!-- Cmd+K Quick Search Trigger Button -->
      <button
        type="button"
        id="cmd-palette-btn"
        class="cmd-trigger-btn"
        aria-label="Open command palette (Ctrl+K or Cmd+K)"
        onclick="window.openCommandPalette && window.openCommandPalette()"
      >
        <Icon name="search" size={14} />
        <span class="cmd-text font-mono">Search</span>
        <kbd class="cmd-kbd font-mono">⌘K</kbd>
      </button>

      <!-- System Status Badge -->
      <div class="desktop-status-wrap">
        <StatusBadge status="operational" label="ALL SYSTEMS OPERATIONAL" size="sm" />
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="mobile-menu-btn"
        aria-label="Open mobile navigation menu"
        aria-controls="mobile-drawer"
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    height: 64px;
    z-index: var(--z-sticky-nav);
    background: rgba(6, 11, 18, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(27, 48, 66, 0.6);
    transition: background-color var(--duration-normal), border-color var(--duration-normal);
  }

  .navbar.scrolled {
    background: rgba(6, 11, 18, 0.94);
    border-bottom-color: var(--color-border);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-primary);
    text-decoration: none;
    letter-spacing: 0.05em;
  }

  .brand-bracket {
    color: var(--color-accent-primary);
  }

  .brand-name {
    transition: color var(--duration-fast);
  }

  .brand-logo:hover .brand-name {
    color: var(--color-accent-primary);
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 900px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
  }

  .nav-link {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding-block: var(--space-2);
    position: relative;
    transition: color var(--duration-fast);
    letter-spacing: 0.06em;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent-primary);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-accent-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  /* Actions */
  .navbar-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .cmd-trigger-btn {
    display: none;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 12px;
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: all var(--duration-fast);
  }

  @media (min-width: 640px) {
    .cmd-trigger-btn {
      display: inline-flex;
    }
  }

  .cmd-trigger-btn:hover {
    border-color: var(--color-border-hover);
    color: var(--color-accent-primary);
    background: var(--color-surface-2);
  }

  .cmd-kbd {
    background: var(--color-bg-0);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 1px 5px;
    font-size: 0.65rem;
    color: var(--color-text-muted);
  }

  .desktop-status-wrap {
    display: none;
  }

  @media (min-width: 1100px) {
    .desktop-status-wrap {
      display: block;
    }
  }

  .mobile-menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--color-text-primary);
    cursor: pointer;
    padding: var(--space-1);
  }

  @media (min-width: 900px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  .mobile-menu-btn:hover {
    color: var(--color-accent-primary);
  }
</style>
