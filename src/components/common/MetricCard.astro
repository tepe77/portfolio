---
import Icon from './Icon.astro';

export interface Props {
  label: string;
  value: string;
  numericTarget: number;
  unit: string;
  description: string;
  sparkline: number[];
  icon?: string;
  delay?: number;
}

const {
  label,
  value,
  numericTarget,
  unit,
  description,
  sparkline,
  icon = 'activity',
  delay = 0
} = Astro.props;

// Generate SVG points for the sparkline (viewBox 100 x 36)
const min = Math.min(...sparkline);
const max = Math.max(...sparkline);
const range = max - min === 0 ? 1 : max - min;
const points = sparkline
  .map((val, idx) => {
    const x = (idx / (sparkline.length - 1)) * 100;
    const y = 32 - ((val - min) / range) * 26;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  })
  .join(' ');
---

<div class="metric-card" data-reveal data-reveal-delay={delay}>
  <div class="metric-header">
    <span class="metric-label">{label}</span>
    <span class="metric-icon-wrap" aria-hidden="true">
      <Icon name={icon} size={16} />
    </span>
  </div>

  <div class="metric-body">
    <div
      class="metric-value font-mono"
      data-counter-target={numericTarget}
      data-counter-unit={unit}
    >
      {value}
    </div>

    <!-- Sparkline visualization (Native SVG) -->
    <div class="metric-sparkline" aria-hidden="true">
      <svg viewBox="0 0 100 36" preserveAspectRatio="none" class="sparkline-svg">
        <defs>
          <linearGradient id={`grad-${label.toLowerCase().replace(/\s+/g, '-')}`} x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="var(--color-accent-primary)" stop-opacity="0.3" />
            <stop offset="100%" stop-color="var(--color-accent-primary)" stop-opacity="0.0" />
          </linearGradient>
        </defs>
        <polyline
          fill="none"
          stroke="var(--color-accent-primary)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          points={points}
        />
      </svg>
    </div>
  </div>

  <div class="metric-footer">
    <span class="metric-desc">{description}</span>
  </div>
</div>

<style>
  .metric-card {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--duration-fast), border-color var(--duration-fast), box-shadow var(--duration-fast);
    position: relative;
    overflow: hidden;
  }

  .metric-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-border-hover);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
  }

  .metric-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .metric-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
  }

  .metric-icon-wrap {
    color: var(--color-accent-primary);
    opacity: 0.7;
  }

  .metric-body {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .metric-value {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .metric-sparkline {
    width: 80px;
    height: 32px;
    flex-shrink: 0;
  }

  .sparkline-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .metric-desc {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .metric-card:hover {
      transform: none !important;
    }
  }
</style>
