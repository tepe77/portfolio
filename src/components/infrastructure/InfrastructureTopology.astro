---
import Icon from '../common/Icon.astro';
import InfrastructureNode from './InfrastructureNode.astro';
---

<div id="infrastructure-topology" class="topology-container blueprint-crosshair" data-reveal>
  <!-- Topology Interactive Control Bar -->
  <div class="topology-toolbar">
    <div class="toolbar-main">
      <div class="toolbar-brand">
        <span class="toolbar-title font-mono">
          <span class="desktop-text">CLUSTER TOPOLOGY // 4-STAGE HA PIPELINE</span>
          <span class="mobile-text">CLUSTER TOPOLOGY // HA</span>
        </span>
        <span class="badge-live font-mono text-xs">● 12 NODES ONLINE</span>
      </div>

      <!-- Filter Buttons -->
      <div class="topology-filters" role="tablist" aria-label="Filter Pipeline Stages">
        <button type="button" class="filter-btn active font-mono text-xs" data-topo-filter="all" role="tab" aria-selected="true">
          <span>ALL</span>
        </button>
        <button type="button" class="filter-btn font-mono text-xs" data-topo-filter="ingress" role="tab" aria-selected="false">
          <span class="desktop-text">01 INGRESS</span>
          <span class="mobile-text">INGRESS</span>
        </button>
        <button type="button" class="filter-btn font-mono text-xs" data-topo-filter="compute" role="tab" aria-selected="false">
          <span class="desktop-text">02 COMPUTE</span>
          <span class="mobile-text">COMPUTE</span>
        </button>
        <button type="button" class="filter-btn font-mono text-xs" data-topo-filter="database" role="tab" aria-selected="false">
          <span class="desktop-text">03 DATABASE HA</span>
          <span class="mobile-text">DATABASE</span>
        </button>
        <button type="button" class="filter-btn font-mono text-xs" data-topo-filter="observability" role="tab" aria-selected="false">
          <span class="desktop-text">04 OPS &amp; BACKUP</span>
          <span class="mobile-text">OPS</span>
        </button>
      </div>
    </div>

    <!-- Interactive Simulation Actions -->
    <div class="toolbar-actions">
      <button
        type="button"
        id="btn-simulate-failover"
        class="action-btn action-failover font-mono text-xs"
        aria-label="Simulate Patroni high availability failover drill"
      >
        <Icon name="refresh" size={13} />
        <span class="desktop-text">FAILOVER DRILL</span>
        <span class="mobile-text">DRILL</span>
      </button>

      <button
        type="button"
        id="btn-health-ping"
        class="action-btn action-ping font-mono text-xs"
        aria-label="Send cluster heartbeat health ping"
      >
        <Icon name="activity" size={13} />
        <span>HEALTH PING</span>
      </button>
    </div>
  </div>

  <!-- Real-time Simulation Alert Banner -->
  <div id="topology-drill-banner" class="drill-banner font-mono text-xs" aria-live="polite">
    <span class="drill-icon">⚡</span>
    <span id="topology-drill-text">Initializing cluster state...</span>
  </div>

  <!-- 4-Stage Horizontal Data Pipeline -->
  <div class="pipeline-wrapper">
    <!-- Dynamic SVG Signal Flow Layer -->
    <svg id="topology-connections-svg" class="topology-connections-svg" aria-hidden="true">
      <defs>
        <linearGradient id="flow-cyan-blue" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#19D3E6" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#5C8DFF" stop-opacity="0.9" />
        </linearGradient>
        <linearGradient id="flow-active-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#19D3E6" stop-opacity="1" />
          <stop offset="100%" stop-color="#20D39B" stop-opacity="1" />
        </linearGradient>
      </defs>
      <g id="topology-svg-paths"></g>
    </svg>

    <div class="pipeline-grid">
      <!-- STAGE 01: EDGE & INGRESS -->
      <div class="pipeline-stage-column" data-stage="ingress">
        <div class="stage-header">
          <div class="stage-tag-row font-mono">
            <span class="stage-step-pill">STAGE 01</span>
            <span class="stage-flow-badge">ENTRY</span>
          </div>
          <h4 class="stage-title font-mono">EDGE &amp; INGRESS</h4>
          <span class="stage-sub">Public Traffic &amp; Gateway</span>
        </div>

        <div class="stage-nodes">
          <InfrastructureNode
            id="internet"
            name="PUBLIC INGRESS"
            subtitle="Cloudflare CDN & Anycast WAF"
            icon="globe"
            status="operational"
            badge="EDGE"
            port=":443 HTTPS"
            connections={["nginx"]}
          />
          <InfrastructureNode
            id="nginx"
            name="NGINX PROXY"
            subtitle="Reverse Proxy & TLS Gateway"
            icon="server"
            status="operational"
            badge="GATEWAY"
            port=":443 / :80"
            connections={["internet", "app-01", "app-02"]}
          />
        </div>

        <div class="stage-flow-indicator" aria-hidden="true">
          <span class="flow-line"></span>
          <span class="flow-chevron">&rarr;</span>
        </div>
      </div>

      <!-- STAGE 02: COMPUTE & CACHING -->
      <div class="pipeline-stage-column" data-stage="compute">
        <div class="stage-header">
          <div class="stage-tag-row font-mono">
            <span class="stage-step-pill">STAGE 02</span>
            <span class="stage-flow-badge">APP MESH</span>
          </div>
          <h4 class="stage-title font-mono">COMPUTE &amp; CACHE</h4>
          <span class="stage-sub">Docker Swarm &amp; Session</span>
        </div>

        <div class="stage-nodes">
          <InfrastructureNode
            id="app-01"
            name="APP NODE 01"
            subtitle="Docker Swarm Worker Replicas"
            icon="docker"
            status="healthy"
            badge="COMPUTE"
            port=":8080 TCP"
            connections={["nginx", "pgbouncer", "redis", "prometheus"]}
          />
          <InfrastructureNode
            id="app-02"
            name="APP NODE 02"
            subtitle="Docker Swarm Worker Replicas"
            icon="docker"
            status="healthy"
            badge="COMPUTE"
            port=":8080 TCP"
            connections={["nginx", "pgbouncer", "redis", "prometheus"]}
          />
          <InfrastructureNode
            id="redis"
            name="REDIS CACHE"
            subtitle="Broker &amp; Session Store"
            icon="layers"
            status="healthy"
            badge="IN-MEMORY"
            port=":6379 TCP"
            connections={["app-01", "app-02"]}
          />
        </div>

        <div class="stage-flow-indicator" aria-hidden="true">
          <span class="flow-line"></span>
          <span class="flow-chevron">&rarr;</span>
        </div>
      </div>

      <!-- STAGE 03: DATABASE HA CLUSTER -->
      <div class="pipeline-stage-column" data-stage="database">
        <div class="stage-header">
          <div class="stage-tag-row font-mono">
            <span class="stage-step-pill">STAGE 03</span>
            <span class="stage-flow-badge">DATA HA</span>
          </div>
          <h4 class="stage-title font-mono">DATABASE HA</h4>
          <span class="stage-sub">Patroni 3-Node &amp; Raft DCS</span>
        </div>

        <div class="stage-nodes">
          <InfrastructureNode
            id="pgbouncer"
            name="PGBOUNCER POOL"
            subtitle="Transaction-Level Pooler"
            icon="refresh"
            status="healthy"
            badge="POOLER"
            port=":6432 TCP"
            connections={["app-01", "app-02", "patroni-01"]}
          />
          <InfrastructureNode
            id="patroni-01"
            name="PATRONI-01"
            subtitle="Primary PostgreSQL Master"
            icon="database"
            status="healthy"
            badge="MASTER"
            port=":5432 RW"
            connections={["pgbouncer", "patroni-02", "patroni-03", "etcd-dcs", "object-storage", "prometheus"]}
          />
          <div class="stage-subgrid-2col">
            <InfrastructureNode
              id="patroni-02"
              name="PATRONI-02"
              subtitle="Sync Standby"
              icon="database"
              status="standby"
              badge="SYNC"
              port=":5432 RO"
              connections={["patroni-01", "etcd-dcs"]}
            />
            <InfrastructureNode
              id="patroni-03"
              name="PATRONI-03"
              subtitle="Async Standby"
              icon="database"
              status="standby"
              badge="ASYNC"
              port=":5432 RO"
              connections={["patroni-01", "etcd-dcs"]}
            />
          </div>
          <InfrastructureNode
            id="etcd-dcs"
            name="ETCD RAFT DCS"
            subtitle="3-Node Consensus Ring"
            icon="network"
            status="active"
            badge="DCS"
            port=":2379 QUORUM"
            connections={["patroni-01", "patroni-02", "patroni-03"]}
          />
        </div>

        <div class="stage-flow-indicator" aria-hidden="true">
          <span class="flow-line"></span>
          <span class="flow-chevron">&rarr;</span>
        </div>
      </div>

      <!-- STAGE 04: OPS & BACKUP -->
      <div class="pipeline-stage-column" data-stage="observability">
        <div class="stage-header">
          <div class="stage-tag-row font-mono">
            <span class="stage-step-pill">STAGE 04</span>
            <span class="stage-flow-badge">OBSERVABILITY</span>
          </div>
          <h4 class="stage-title font-mono">OPS &amp; BACKUP</h4>
          <span class="stage-sub">Telemetry &amp; Encrypted S3</span>
        </div>

        <div class="stage-nodes">
          <InfrastructureNode
            id="object-storage"
            name="ENCRYPTED S3"
            subtitle="WAL-G Backups &amp; Snapshots"
            icon="cloud"
            status="healthy"
            badge="STORAGE"
            port=":9000 S3"
            connections={["patroni-01"]}
          />
          <InfrastructureNode
            id="prometheus"
            name="PROMETHEUS TSDB"
            subtitle="Telemetry &amp; Metrics Scraper"
            icon="activity"
            status="active"
            badge="SCRAPER"
            port=":9090 TCP"
            connections={["grafana", "app-01", "app-02", "patroni-01"]}
          />
          <InfrastructureNode
            id="grafana"
            name="GRAFANA METRICS"
            subtitle="Operational Dashboards"
            icon="chart"
            status="active"
            badge="DASHBOARD"
            port=":3000 HTTP"
            connections={["prometheus"]}
          />
        </div>
      </div>
    </div>

    <!-- Integrated Inspector Dock (Bottom Master-Detail Console) -->
    <aside id="topology-details-panel" class="topology-inspector-dock" aria-label="Service Details Inspector">
      <!-- Default Calm Telemetry Status Bar -->
      <div id="inspector-idle-bar" class="inspector-idle-bar font-mono text-xs">
        <div class="idle-left">
          <span class="idle-icon text-cyan">●</span>
          <span>SELECT ANY SERVICE NODE TO TRACE SIGNALS AND INSPECT ARCHITECTURE SPECIFICATIONS</span>
        </div>
        <div class="idle-right text-muted">
          <span>HA QUORUM: 3/3 OK</span>
          <span class="idle-sep">•</span>
          <span>FAILOVER: PATRONI-02 READY</span>
          <span class="idle-sep">•</span>
          <span class="text-green">RPO: 0 SEC</span>
        </div>
      </div>

      <!-- Active Node Detail HUD (Reveals when a node is selected) -->
      <div id="inspector-active-content" class="inspector-active-content" style="display: none;">
        <div class="panel-header">
          <div class="panel-header-title">
            <span id="topology-detail-category" class="panel-category font-mono text-xs">TIER // CATEGORY</span>
            <h3 id="topology-detail-title" class="panel-title">Service Details</h3>
          </div>
          <button type="button" id="topology-detail-close" class="panel-close-btn font-mono text-xs" aria-label="Close service details inspector">
            <span>CLOSE</span>
            <kbd class="kbd-hint">ESC</kbd>
          </button>
        </div>

        <!-- Telemetry HUD Grid -->
        <div class="panel-telemetry-hud">
          <div class="hud-item font-mono">
            <span class="hud-lbl">BIND PORT</span>
            <span id="topology-detail-port" class="hud-val text-cyan">:443</span>
          </div>
          <div class="hud-item font-mono">
            <span class="hud-lbl">SUBNET</span>
            <span id="topology-detail-subnet" class="hud-val">10.244.0.0/24</span>
          </div>
          <div class="hud-item font-mono">
            <span class="hud-lbl">LATENCY</span>
            <span id="topology-detail-latency" class="hud-val text-green">0.8ms</span>
          </div>
          <div class="hud-item font-mono">
            <span class="hud-lbl">ACTIVE CONNS</span>
            <span id="topology-detail-conns" class="hud-val">1,240 pool</span>
          </div>
          <div class="hud-item font-mono">
            <span class="hud-lbl">THROUGHPUT</span>
            <span id="topology-detail-throughput" class="hud-val">8.6 MB/s</span>
          </div>
          <div id="topology-detail-lag-row" class="hud-item font-mono" style="display: none;">
            <span class="hud-lbl">REPLICA LAG</span>
            <span id="topology-detail-lag" class="hud-val text-green">0 bytes</span>
          </div>
        </div>

        <div class="panel-spec-columns">
          <div class="panel-spec-col">
            <div class="panel-section">
              <span class="panel-section-label font-mono">FUNCTION &amp; ROLE</span>
              <p id="topology-detail-desc" class="panel-text"></p>
            </div>
            <div class="panel-section">
              <span class="panel-section-label font-mono">ARCHITECTURE IMPLEMENTATION</span>
              <p id="topology-detail-arch" class="panel-arch font-mono"></p>
            </div>
          </div>

          <div class="panel-spec-col">
            <div class="panel-section">
              <span class="panel-section-label font-mono">ENGINEERING CONTROLS</span>
              <div id="topology-detail-tech" class="panel-tags"></div>
            </div>
            <div class="panel-section">
              <span class="panel-section-label font-mono">CONNECTED SERVICES</span>
              <div id="topology-detail-connected" class="connected-nodes-list font-mono text-xs"></div>
            </div>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>

<style>
  .topology-container {
    background: linear-gradient(180deg, var(--color-bg-1) 0%, var(--color-bg-0) 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md), 0 0 40px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .desktop-text {
    display: inline;
  }

  .mobile-text {
    display: none;
  }

  /* Control Toolbar */
  .topology-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    background: var(--color-surface-1);
    border-bottom: 1px solid var(--color-border);
  }

  .toolbar-main {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .toolbar-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .toolbar-title {
    color: var(--color-text-primary);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .badge-live {
    color: var(--color-success);
    background: rgba(32, 211, 155, 0.1);
    padding: 2px 7px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(32, 211, 155, 0.3);
    font-size: 0.65rem;
  }

  .topology-filters {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: var(--color-bg-0);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    padding: 4px 10px;
    cursor: pointer;
    font-weight: 600;
    letter-spacing: 0.03em;
    transition: all var(--duration-fast);
    font-size: 0.68rem;
  }

  .filter-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-hover);
  }

  .filter-btn.active {
    background: var(--color-surface-2);
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    box-shadow: 0 0 10px rgba(25, 211, 230, 0.18);
  }

  .toolbar-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 5px 11px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-weight: 700;
    font-size: 0.68rem;
    transition: all var(--duration-fast);
  }

  .action-failover {
    background: rgba(245, 185, 66, 0.12);
    border: 1px solid rgba(245, 185, 66, 0.4);
    color: var(--color-warning);
  }

  .action-failover:hover {
    background: var(--color-warning);
    color: var(--color-bg-0);
    box-shadow: 0 0 14px rgba(245, 185, 66, 0.35);
  }

  .action-ping {
    background: rgba(25, 211, 230, 0.08);
    border: 1px solid var(--color-border);
    color: var(--color-accent-primary);
  }

  .action-ping:hover {
    background: var(--color-surface-2);
    border-color: var(--color-border-hover);
  }

  /* Drill Alert Banner */
  .drill-banner {
    display: none;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-5);
    background: rgba(245, 185, 66, 0.12);
    border-bottom: 1px solid var(--color-warning);
    color: var(--color-warning);
    animation: pulse-dot-warning 2s infinite;
  }

  .drill-banner.active {
    display: flex;
  }

  /* Pipeline Stage Layout */
  .pipeline-wrapper {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    gap: var(--space-5);
    position: relative;
  }

  .topology-connections-svg {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
    width: calc(100% - var(--space-5) * 2);
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }

  .pipeline-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    position: relative;
    z-index: 2;
  }

  :global(.topo-line) {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
    opacity: 0.25;
    transition: opacity var(--duration-fast), stroke-width var(--duration-fast), stroke var(--duration-fast);
  }

  :global(.topo-line.topo-line-primary) {
    stroke: url(#flow-cyan-blue);
    stroke-width: 2;
    opacity: 0.65;
    animation: flow-dash 1.4s linear infinite;
  }

  :global(.topo-line.line-active) {
    stroke: var(--color-accent-primary) !important;
    stroke-width: 2.8 !important;
    opacity: 1 !important;
    filter: drop-shadow(0 0 6px var(--color-accent-primary));
    animation: flow-dash 0.8s linear infinite !important;
  }

  :global(.topo-line.line-dimmed) {
    opacity: 0.05 !important;
  }

  :global(.topo-line.line-failover) {
    stroke: var(--color-danger) !important;
    stroke-width: 2.8 !important;
    opacity: 1 !important;
    filter: drop-shadow(0 0 6px var(--color-danger));
  }

  :global(.topo-line.line-promoted) {
    stroke: var(--color-success) !important;
    stroke-width: 2.8 !important;
    opacity: 1 !important;
    filter: drop-shadow(0 0 8px var(--color-success));
    animation: flow-dash 0.6s linear infinite !important;
  }

  .pipeline-stage-column {
    display: flex;
    flex-direction: column;
    background: rgba(16, 26, 38, 0.5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    position: relative;
    transition: all var(--duration-fast);
  }

  .pipeline-stage-column:hover {
    border-color: var(--color-border-hover);
    background: rgba(16, 26, 38, 0.7);
  }

  :global(.pipeline-stage-column.stage-dimmed) {
    opacity: 0.25;
  }

  :global(.pipeline-stage-column.stage-active) {
    border-color: var(--color-accent-primary);
    background: rgba(20, 33, 48, 0.85);
  }

  .stage-header {
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid rgba(27, 48, 66, 0.6);
  }

  .stage-tag-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 3px;
  }

  .stage-step-pill {
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--color-accent-primary);
    letter-spacing: 0.05em;
  }

  .stage-flow-badge {
    font-size: 0.58rem;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    padding: 1px 5px;
    border-radius: 3px;
    border: 1px solid var(--color-border);
  }

  .stage-title {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: 0.03em;
    line-height: 1.2;
    margin: 0;
  }

  .stage-sub {
    font-size: 0.64rem;
    color: var(--color-text-muted);
  }

  .stage-nodes {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .stage-subgrid-2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  /* Connecting arrow between columns */
  .stage-flow-indicator {
    position: absolute;
    top: 50%;
    right: -13px;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: bold;
    z-index: 4;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    pointer-events: none;
  }

  /* Integrated Inspector Dock */
  .topology-inspector-dock {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all var(--duration-normal) var(--ease-standard);
  }

  .inspector-idle-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    color: var(--color-text-secondary);
    letter-spacing: 0.04em;
  }

  .idle-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .idle-icon {
