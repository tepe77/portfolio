---
import Icon from '../common/Icon.astro';

const navLinks = [
  { label: "ABOUT", href: "#about" },
  { label: "INFRA", href: "#infrastructure" },
  { label: "PROJECTS", href: "#projects" },
  { label: "CI/CD", href: "#pipeline" },
  { label: "STACK", href: "#stack" },
  { label: "EXPERIENCE", href: "#experience" },
  { label: "CONTACT", href: "#contact" }
];
---

<header id="main-navbar" class="navbar">
  <div class="container navbar-container">
    <!-- Brand Logo with micro pulse status dot -->
    <a href="#" class="brand-logo" aria-label="Prasaswo Tepe Portfolio Home">
      <span class="status-indicator-dot" title="Systems Operational" aria-hidden="true"></span>
      <span class="brand-bracket font-mono">&lt;&gt;</span>
      <span class="brand-name font-mono">PRASASWO.TEPE</span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="nav-link font-mono">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Right Controls: Theme Toggle & Compact Cmd+K Search -->
    <div class="navbar-actions">
      <button
        type="button"
        id="theme-toggle-btn"
        class="theme-toggle-btn"
        aria-label="Toggle light or dark theme"
        title="Toggle Theme"
      >
        <span class="icon-sun-wrap" aria-hidden="true">
          <Icon name="sun" size={15} />
        </span>
        <span class="icon-moon-wrap" aria-hidden="true">
          <Icon name="moon" size={15} />
        </span>
      </button>

      <button
        type="button"
        id="cmd-palette-btn"
        class="cmd-trigger-btn"
        aria-label="Open command palette (Ctrl+K or Cmd+K)"
        onclick="window.openCommandPalette && window.openCommandPalette()"
      >
        <Icon name="search" size={13} />
        <kbd class="cmd-kbd font-mono">⌘K</kbd>
      </button>
    </div>
  </div>

  <!-- Slim Scroll Progress Rail -->
  <div id="navbar-scroll-progress" class="navbar-scroll-progress" aria-hidden="true"></div>
</header>

<style>
  .navbar-scroll-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent-primary), var(--color-accent-secondary));
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.08s ease-out;
    pointer-events: none;
    border-radius: var(--radius-pill);
    opacity: 0.85;
    z-index: 10;
  }

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 60px;
    z-index: var(--z-sticky-nav);
    background: var(--color-nav-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
    transition: 
      top 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      width 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      max-width 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      height 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-radius 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      padding 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .navbar.scrolled {
    background: var(--color-nav-scrolled);
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  /* Desktop floating pill style & transition */
  @media (min-width: 900px) {
    .navbar {
      top: 18px;
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      width: min(calc(100% - 48px), 980px);
      height: 54px;
      border-radius: var(--radius-pill);
      border: 1px solid var(--color-border);
      background: var(--color-surface-glass);
      backdrop-filter: blur(20px) saturate(160%);
      -webkit-backdrop-filter: blur(20px) saturate(160%);
      box-shadow: 
        inset 0 1px 0 0 rgba(255, 255, 255, 0.15),
        0 14px 40px var(--shadow-md),
        0 0 24px rgba(var(--color-accent-primary-rgb), 0.1);
      padding-inline: var(--space-5);
    }

    .navbar .navbar-container {
      width: 100%;
      max-width: 100%;
      padding-inline: 0;
    }

    .navbar.scrolled {
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 100%;
      height: 64px;
      border-radius: 0;
      border-top: none;
      border-left: none;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-nav-scrolled);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: var(--shadow-sm);
      padding-inline: 0;
    }

    .navbar.scrolled .navbar-container {
      width: min(calc(100% - 64px), 1420px);
      margin-inline: auto;
      padding-inline: 0;
    }
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    transition: max-width 0.35s cubic-bezier(0.16, 1, 0.3, 1), padding 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-primary);
    text-decoration: none;
    letter-spacing: 0.05em;
  }

  .status-indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 8px rgba(32, 211, 155, 0.8);
    display: inline-block;
    flex-shrink: 0;
    animation: status-pulse 3s infinite ease-in-out;
  }

  @keyframes status-pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.85);
    }
  }

  .brand-bracket {
    color: var(--color-accent-primary);
  }

  .brand-name {
    transition: color var(--duration-fast);
  }

  .brand-logo:hover .brand-name {
    color: var(--color-accent-primary);
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 900px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.8vw, 22px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding-block: var(--space-2);
    position: relative;
    transition: color var(--duration-fast);
    letter-spacing: 0.06em;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent-primary);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-accent-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  /* Actions */
  .navbar-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-standard);
    position: relative;
    overflow: hidden;
  }

  .theme-toggle-btn:hover {
    color: var(--color-accent-primary);
    border-color: var(--color-border-hover);
    background: var(--color-surface-1);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px var(--shadow-sm);
  }

  .theme-toggle-btn:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .icon-sun-wrap,
  .icon-moon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--duration-normal) var(--ease-standard), opacity var(--duration-normal) var(--ease-standard);
  }

  /* In dark mode: show sun icon */
  :global(:root) .icon-sun-wrap,
  :global([data-theme="dark"]) .icon-sun-wrap {
    display: flex;
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  :global(:root) .icon-moon-wrap,
  :global([data-theme="dark"]) .icon-moon-wrap {
    display: none;
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  /* In light mode: show moon icon */
  :global([data-theme="light"]) .icon-sun-wrap {
    display: none;
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  :global([data-theme="light"]) .icon-moon-wrap {
    display: flex;
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .cmd-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 10px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: all var(--duration-fast);
    outline: none;
  }

  .cmd-trigger-btn:hover {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    background: var(--color-surface-1);
    box-shadow: 0 0 12px rgba(var(--color-accent-primary-rgb), 0.15);
  }

  .cmd-trigger-btn:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .cmd-kbd {
    background: var(--color-bg-0);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 1px 4px;
    font-size: 0.65rem;
    color: var(--color-text-muted);
    line-height: 1.2;
  }

  @media (max-width: 480px) {
    .navbar {
      height: 56px;
    }
    .brand-logo {
      font-size: 0.82rem;
      gap: 5px;
    }
    .cmd-trigger-btn {
      height: 30px;
      padding: 0 8px;
    }
  }

  @media (max-width: 360px) {
    .brand-logo {
      font-size: 0.74rem;
      gap: 4px;
    }
    .cmd-kbd {
      display: none;
    }
    .cmd-trigger-btn {
      padding: 0 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-indicator-dot {
      animation: none;
    }
  }
</style>
