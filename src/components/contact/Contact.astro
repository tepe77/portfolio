---
import SectionHeader from '../common/SectionHeader.astro';
import Button from '../common/Button.astro';
import Icon from '../common/Icon.astro';
import SocialLinks from './SocialLinks.astro';
import { profileData } from '../../data/profile';
---

<section id="contact" class="contact-section">
  <div class="container">
    <!-- Live Availability Status Pill -->
    <div class="availability-strip" data-reveal>
      <div class="availability-badge font-mono text-xs">
        <span class="availability-pulse-dot" aria-hidden="true"></span>
        <span class="availability-text">STATUS: AVAILABLE FOR DEVOPS &amp; SRE ROLES</span>
      </div>
    </div>

    <SectionHeader
      eyebrow="08 // INITIATE TRANSMISSION"
      title="LET'S BUILD RELIABLE SYSTEMS"
      description="Interested in infrastructure engineering, CI/CD automation, database clustering, or operational reliability? Let's connect."
      align="center"
    />

    <div class="contact-wrapper" data-reveal data-reveal-delay={100}>
      <!-- Terminal Contact Console Card -->
      <div class="contact-terminal font-mono">
        <div class="ct-header">
          <div class="ct-tab-group" role="tablist" aria-label="Terminal command formats">
            <button type="button" class="ct-tab-btn active" data-cmd="ssh" role="tab" aria-selected="true">
              <span>SSH</span>
            </button>
            <button type="button" class="ct-tab-btn" data-cmd="curl" role="tab" aria-selected="false">
              <span>CURL</span>
            </button>
          </div>

          <span class="ct-window-title font-mono text-xs">session // contact.sh</span>

          <button
            type="button"
            class="ct-copy-cmd-btn font-mono text-xs"
            id="copy-cmd-btn"
            aria-label="Copy terminal command"
          >
            <Icon name="copy" size={13} />
            <span id="copy-cmd-text">COPY COMMAND</span>
          </button>
        </div>

        <div class="ct-body">
          <div class="ct-line">
            <span class="ct-prompt">prasaswo@portfolio:~$</span>
            <span class="ct-cmd" id="terminal-cmd-display">ssh connect@prasaswo.dev</span>
          </div>
          <div class="ct-output">
            <p class="ct-meta">SSH-2.0-OpenSSH_9.2p1 Debian-2+deb12u2</p>
            <p class="text-green ct-success-line">✔ Direct encrypted channel established (Ed25519 authenticated).</p>
            <p class="text-muted">Ready for collaboration, infrastructure consultations, or full-time opportunities.</p>
          </div>
        </div>
      </div>

      <!-- Primary Action Buttons -->
      <div class="contact-cta-bar">
        <Button href={`mailto:${profileData.email}`} variant="primary" size="lg">
          <Icon name="external-link" size={18} />
          <span>EMAIL ME DIRECTLY</span>
        </Button>

        <button
          type="button"
          id="copy-email-btn"
          class="btn-copy-email font-mono"
          data-email={profileData.email}
          aria-label="Copy email address to clipboard"
        >
          <Icon name="copy" size={18} />
          <span id="copy-email-text">COPY EMAIL</span>
        </button>

        <Button href={profileData.resumeUrl} variant="secondary" size="lg" download="prasaswo-tepe-resume.pdf">
          <Icon name="download" size={18} />
          <span>DOWNLOAD RESUME</span>
        </Button>
      </div>

      <!-- Technical SLA / Meta Footer Info -->
      <div class="contact-sla-grid font-mono text-xs">
        <div class="sla-card">
          <span class="sla-key text-muted">RESPONSE SLA:</span>
          <span class="sla-val text-green">&lt; 24 HOURS</span>
        </div>
        <div class="sla-card">
          <span class="sla-key text-muted">TIMEZONE:</span>
          <span class="sla-val">UTC+7 (WIB / JAKARTA)</span>
        </div>
        <div class="sla-card">
          <span class="sla-key text-muted">PREFERRED ENGAGEMENTS:</span>
          <span class="sla-val text-cyan">DEVOPS, SRE, PLATFORM ARCHITECTURE</span>
        </div>
      </div>

      <!-- Social Links Grid -->
      <SocialLinks />
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    padding-block: clamp(var(--space-12), 6vw, var(--space-20));
  }

  .availability-strip {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .availability-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: rgba(32, 211, 155, 0.1);
    border: 1px solid rgba(32, 211, 155, 0.3);
    color: var(--color-success);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .availability-pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 8px var(--color-success);
    animation: pulse-dot 2s infinite;
  }

  .contact-wrapper {
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Contact Terminal Window */
  .contact-terminal {
    background: var(--color-bg-0);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  }

  .ct-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
  }

  .ct-tab-group {
    display: flex;
    gap: 4px;
  }

  .ct-tab-btn {
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text-muted);
    font-size: 0.68rem;
    font-family: var(--font-mono);
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--duration-fast);
  }

  .ct-tab-btn:hover {
    color: var(--color-text-primary);
  }

  .ct-tab-btn.active {
    background: var(--color-bg-0);
    border-color: var(--color-border);
    color: var(--color-accent-primary);
  }

  .ct-window-title {
    color: var(--color-text-muted);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .ct-copy-cmd-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--color-bg-0);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    padding: 3px 8px;
    cursor: pointer;
    font-weight: 600;
    transition: all var(--duration-fast);
  }

  .ct-copy-cmd-btn:hover {
    color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
  }

  .ct-body {
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .ct-line {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .ct-prompt {
    color: var(--color-accent-primary);
    font-weight: 700;
  }

  .ct-cmd {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .ct-output {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .ct-output p {
    margin: 0;
  }

  .ct-meta {
    color: var(--color-text-muted);
  }

  .ct-success-line {
    font-weight: 600;
  }

  /* Action Buttons Bar */
  .contact-cta-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .btn-copy-email {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    transition: all var(--duration-fast);
    outline: none;
    user-select: none;
    min-height: 48px;
  }

  .btn-copy-email:hover {
    background: var(--color-surface-2);
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    box-shadow: 0 0 16px rgba(25, 211, 230, 0.2);
  }

  .btn-copy-email.copied {
    background: rgba(32, 211, 155, 0.15);
    border-color: var(--color-success);
    color: var(--color-success);
    box-shadow: 0 0 16px rgba(32, 211, 155, 0.3);
  }

  /* Technical SLA Grid */
  .contact-sla-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .sla-card {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .sla-key {
    font-size: 0.65rem;
    font-weight: 700;
  }

  .sla-val {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .text-cyan {
    color: var(--color-accent-primary);
  }

  @media (max-width: 768px) {
    .contact-sla-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .contact-cta-bar {
      flex-direction: column;
      align-items: stretch;
    }

    .ct-window-title {
      display: none;
    }
  }

  /* Light Mode Specific Overrides */
  :global([data-theme="light"]) .contact-terminal {
    background: #f0f0f0;
    border-color: rgba(209, 217, 226, 0.75);
    box-shadow: 0 4px 16px #0000000f;
  }

  :global([data-theme="light"]) .ct-header {
    background: #e8e8e8;
    border-bottom-color: rgba(209, 217, 226, 0.75);
  }

  :global([data-theme="light"]) .ct-tab-btn.active {
    background: #FFFFFF;
    border-color: rgba(209, 217, 226, 0.75);
  }

  :global([data-theme="light"]) .ct-copy-cmd-btn {
    background: #FFFFFF;
    border-color: rgba(209, 217, 226, 0.75);
  }

  :global([data-theme="light"]) .btn-copy-email {
    background: #FFFFFF;
    border-color: rgba(209, 217, 226, 0.85);
    box-shadow: 0 1px 3px #00000008;
  }

  :global([data-theme="light"]) .btn-copy-email:hover {
    background: #FFFFFF;
    border-color: var(--color-accent-primary);
    box-shadow: 0 4px 14px #0000000f;
  }

  :global([data-theme="light"]) .sla-card {
    background: #FFFFFF;
    border-color: rgba(209, 217, 226, 0.75);
    box-shadow: 0 1px 3px #00000008;
  }
</style>

<script>
  function initContactSection() {
    const copyEmailBtn = document.getElementById('copy-email-btn');
    const copyEmailText = document.getElementById('copy-email-text');
    const copyCmdBtn = document.getElementById('copy-cmd-btn');
    const copyCmdText = document.getElementById('copy-cmd-text');
    const cmdDisplay = document.getElementById('terminal-cmd-display');
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.ct-tab-btn');

    const commands: Record<string, string> = {
      ssh: 'ssh connect@prasaswo.dev',
      curl: 'curl -s https://prasaswo.dev/contact'
    };

    let activeCmdType = 'ssh';

    tabBtns.forEach((tab) => {
      tab.addEventListener('click', () => {
        const cmdType = tab.dataset.cmd;
        if (!cmdType || !commands[cmdType]) return;

        activeCmdType = cmdType;
        tabBtns.forEach((t) => {
          const isActive = t === tab;
          t.classList.toggle('active', isActive);
          t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        if (cmdDisplay) {
          cmdDisplay.textContent = commands[cmdType];
        }
      });
    });

    copyCmdBtn?.addEventListener('click', async () => {
      const cmdText = commands[activeCmdType] || 'ssh connect@prasaswo.dev';
      try {
        await navigator.clipboard.writeText(cmdText);
        if (copyCmdText) copyCmdText.textContent = 'COPIED!';
        setTimeout(() => {
          if (copyCmdText) copyCmdText.textContent = 'COPY COMMAND';
        }, 2200);
      } catch {
        if (copyCmdText) copyCmdText.textContent = 'FAILED';
      }
    });

    copyEmailBtn?.addEventListener('click', async () => {
      const email = copyEmailBtn.dataset.email || 'prasaswo@gmail.com';
      try {
        await navigator.clipboard.writeText(email);
        if (copyEmailText) copyEmailText.textContent = 'COPIED TO CLIPBOARD!';
        copyEmailBtn.classList.add('copied');
        setTimeout(() => {
          if (copyEmailText) copyEmailText.textContent = 'COPY EMAIL';
          copyEmailBtn.classList.remove('copied');
        }, 2500);
      } catch {
        if (copyEmailText) copyEmailText.textContent = email;
      }
    });
  }

  initContactSection();
  document.addEventListener('astro:page-load', initContactSection);
</script>
