---
import Icon from '../common/Icon.astro';

const bottomNavItems = [
  { id: 'about', label: 'ABOUT', href: '#about', icon: 'terminal' },
  { id: 'infrastructure', label: 'INFRA', href: '#infrastructure', icon: 'server' },
  { id: 'projects', label: 'WORK', href: '#projects', icon: 'layers' },
  { id: 'pipeline', label: 'CI/CD', href: '#pipeline', icon: 'zap' },
  { id: 'stack', label: 'STACK', href: '#stack', icon: 'cpu' },
  { id: 'experience', label: 'EXP', href: '#experience', icon: 'activity' },
  { id: 'contact', label: 'CONTACT', href: '#contact', icon: 'arrow-up-right' }
];
---

<nav id="mobile-bottom-nav" class="mobile-bottom-bar" aria-label="Mobile Bottom Navigation">
  <div class="bottom-nav-inner">
    {bottomNavItems.map((item) => (
      <a
        href={item.href}
        class="bottom-nav-link font-mono"
        data-nav-id={item.id}
        aria-label={`Jump to ${item.label} section`}
      >
        <span class="nav-icon-wrap" aria-hidden="true">
          <Icon name={item.icon} size={17} />
        </span>
        <span class="nav-label">{item.label}</span>
      </a>
    ))}
  </div>
</nav>

<style>
  .mobile-bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 380;
    background: rgba(6, 11, 18, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid rgba(27, 48, 66, 0.75);
    box-shadow: 0 -6px 28px rgba(0, 0, 0, 0.55);
    padding-bottom: max(6px, env(safe-area-inset-bottom, 0px));
    padding-top: 5px;
    padding-inline: 4px;
    transition: transform var(--duration-fast), opacity var(--duration-fast);
  }

  @media (min-width: 900px) {
    .mobile-bottom-bar {
      display: none !important;
    }
  }

  .bottom-nav-inner {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    align-items: center;
    max-width: 520px;
    margin: 0 auto;
    width: 100%;
  }

  .bottom-nav-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 6px 2px 4px;
    color: var(--color-text-muted);
    text-decoration: none;
    position: relative;
    border-radius: var(--radius-sm);
    transition: color var(--duration-fast), transform var(--duration-fast), background-color var(--duration-fast);
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  .bottom-nav-link:hover,
  .bottom-nav-link:focus-visible {
    color: var(--color-text-primary);
  }

  .nav-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    transition: transform var(--duration-fast), color var(--duration-fast);
  }

  .nav-label {
    font-size: 0.60rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
  }

  /* Active state when section is scrolled into view or clicked */
  .bottom-nav-link.active {
    color: var(--color-accent-primary);
  }

  .bottom-nav-link.active .nav-icon-wrap {
    color: var(--color-accent-primary);
    transform: translateY(-1px);
    filter: drop-shadow(0 0 6px rgba(25, 211, 230, 0.45));
  }

  .bottom-nav-link.active::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 22%;
    right: 22%;
    height: 2px;
    background: var(--color-accent-primary);
    box-shadow: 0 0 8px var(--color-accent-primary);
    border-radius: 2px;
  }

  @media (max-width: 360px) {
    .nav-label {
      font-size: 0.52rem;
      letter-spacing: 0;
    }
    .nav-icon-wrap :global(svg) {
      width: 15px;
      height: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bottom-nav-link.active .nav-icon-wrap {
      transform: none !important;
    }
  }
</style>
