---
import Button from '../common/Button.astro';
import Icon from '../common/Icon.astro';
import HeroTopology from './HeroTopology.astro';
import HeroMetrics from './HeroMetrics.astro';
import HeroDeploymentCanvas from './HeroDeploymentCanvas.astro';
import { profileData } from '../../data/profile';
---

<section id="hero" class="hero-section">
  <!-- Minimalist 3D Deployment Flow Canvas Background -->
  <HeroDeploymentCanvas />

  <div class="container-wide hero-container">
    <!-- Left Column: Identity & Value Proposition -->
    <div class="hero-content" data-reveal>
      <div class="hero-eyebrow font-mono">
        <span class="eyebrow-slash">//</span>
        <span>{profileData.eyebrow}</span>
        <span class="eyebrow-name">{profileData.name}</span>
      </div>

      <h1 class="hero-title">
        <span class="text-gradient">DEVOPS ENGINEER</span>
        <span class="title-ampersand">&amp;</span>
        <span class="text-gradient-secondary">INFRASTRUCTURE</span>
        <span class="title-suffix">ENGINEER</span>
      </h1>

      <p class="hero-description">
        {profileData.summary}
      </p>

      <div class="hero-cta-group">
        <Button href="#projects" variant="primary" size="lg">
          EXPLORE MY WORK
          <Icon name="arrow-right" size={18} />
        </Button>

        <Button href={profileData.resumeUrl} variant="secondary" size="lg" download="prasaswo-tepe-resume.pdf">
          <Icon name="download" size={18} />
          DOWNLOAD RESUME
        </Button>
      </div>

      <!-- Live simulated metrics -->
      <HeroMetrics />
    </div>

    <!-- Right Column: Interactive Topology Preview -->
    <div class="hero-visual">
      <HeroTopology />
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(60px, 8vw, 100px);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--space-10);
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent-primary);
    letter-spacing: 0.12em;
    margin-bottom: var(--space-3);
  }

  .eyebrow-slash {
    color: var(--color-text-muted);
  }

  .eyebrow-name {
    color: var(--color-text-primary);
    border-left: 1px solid var(--color-border);
    padding-left: var(--space-2);
  }

  .hero-title {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
  }

  .text-gradient {
    background: linear-gradient(135deg, #FFFFFF 30%, var(--color-accent-primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .title-ampersand {
    font-size: 0.7em;
    color: var(--color-accent-primary);
    font-weight: 300;
    margin-block: -4px;
  }

  .text-gradient-secondary {
    background: linear-gradient(135deg, #E6EDF3 40%, var(--color-accent-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .title-suffix {
    color: var(--color-text-primary);
  }

  .hero-description {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 620px;
    margin-bottom: var(--space-6);
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .hero-visual {
    width: 100%;
  }

  @media (max-width: 640px) {
    .hero-cta-group {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
