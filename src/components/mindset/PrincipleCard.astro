---
export interface Props {
  id: string;
  num: string;
  title: string;
  category: string;
  index: number;
  isActive: boolean;
}

const { num, title, category, index, isActive } = Astro.props;
---

<button
  type="button"
  role="tab"
  id={`axiom-tab-${index}`}
  class:list={['axiom-tab-btn', { 'is-active': isActive }]}
  data-axiom-index={index}
  aria-selected={isActive ? 'true' : 'false'}
  aria-controls={`axiom-panel-${index}`}
  tabindex={isActive ? 0 : -1}
>
  <div class="tab-header">
    <span class="tab-num font-mono">{num}</span>
    <span class="tab-status-pill font-mono">
      <span class="status-dot" aria-hidden="true"></span>
      <span class="status-label">ENFORCED</span>
    </span>
  </div>

  <div class="tab-body">
    <span class="tab-category font-mono">{category}</span>
    <h3 class="tab-title font-mono">{title}</h3>
  </div>

  <div class="tab-active-indicator" aria-hidden="true"></div>
</button>

<style>
  .axiom-tab-btn {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: clamp(var(--space-4), 1.6vw, var(--space-5)) var(--space-5);
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border);
    border-left: 3px solid transparent;
    cursor: pointer;
    text-align: left;
    position: relative;
    transition:
      background var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
    min-height: 44px; /* WCAG 44px touch target */
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .axiom-tab-btn:hover {
    background: rgba(16, 26, 38, 0.6);
    border-left-color: rgba(25, 211, 230, 0.4);
  }

  .axiom-tab-btn:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: -2px;
  }

  .axiom-tab-btn.is-active {
    background: rgba(25, 211, 230, 0.07);
    border-left-color: var(--color-accent-primary);
    box-shadow: inset 1px 0 0 rgba(25, 211, 230, 0.3);
  }

  .tab-header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .tab-num {
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .axiom-tab-btn:hover .tab-num,
  .axiom-tab-btn.is-active .tab-num {
    color: var(--color-accent-primary);
  }

  .tab-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.625rem;
    color: var(--color-success);
    letter-spacing: 0.08em;
    background: rgba(32, 211, 155, 0.08);
    border: 1px solid rgba(32, 211, 155, 0.25);
    padding: 2px 7px;
    border-radius: var(--radius-pill);
  }

  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 6px var(--color-success);
  }

  .tab-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .tab-category {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-accent-primary);
    text-transform: uppercase;
    opacity: 0.85;
  }

  .tab-title {
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: 0.02em;
    margin: 0;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .axiom-tab-btn:hover .tab-title,
  .axiom-tab-btn.is-active .tab-title {
    color: #FFFFFF;
  }

  .tab-active-indicator {
    position: absolute;
    right: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-primary);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .axiom-tab-btn.is-active .tab-active-indicator {
    opacity: 1;
    box-shadow: 0 0 8px var(--color-accent-primary);
  }

  /* Responsive styling for horizontal tab strip on tablet and mobile */
  @media (max-width: 960px) {
    .axiom-tab-btn {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--color-border);
      border-left: 3px solid transparent;
      padding: var(--space-3) var(--space-4);
    }

    .tab-header {
      width: auto;
      gap: var(--space-3);
    }

    .tab-body {
      flex: 1;
      margin-left: var(--space-3);
    }

    .tab-active-indicator {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .axiom-tab-btn {
      padding: var(--space-3);
    }

    .tab-status-pill {
      font-size: 0.5625rem;
      padding: 1px 5px;
    }

    .tab-title {
      font-size: 0.875rem;
    }

    .tab-category {
      font-size: 0.5625rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .axiom-tab-btn,
    .tab-num,
    .tab-title,
    .tab-active-indicator {
      transition: none !important;
    }
  }

  /* Light Mode Specific Overrides */
  :global([data-theme="light"]) .axiom-tab-btn:hover {
    background: #e8e8e8;
  }

  :global([data-theme="light"]) .axiom-tab-btn.is-active {
    background: #FFFFFF;
    box-shadow: inset 2px 0 0 var(--color-accent-primary);
  }

  :global([data-theme="light"]) .axiom-tab-btn:hover .tab-title,
  :global([data-theme="light"]) .axiom-tab-btn.is-active .tab-title {
    color: var(--color-text-primary);
  }
</style>
