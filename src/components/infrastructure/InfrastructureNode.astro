---
import Icon from '../common/Icon.astro';

export interface Props {
  id: string;
  name: string;
  subtitle: string;
  icon: string;
  status: "healthy" | "operational" | "active" | "standby";
  connections: string[];
  port?: string;
  badge?: string;
  class?: string;
  top?: string;
  left?: string;
  right?: string;
  bottom?: string;
}

const {
  id,
  name,
  subtitle,
  icon,
  status,
  connections,
  port,
  badge,
  class: className = ""
} = Astro.props;
---

<div
  class={`infra-node ${className}`}
  data-node-id={id}
  data-connections={connections.join(',')}
  tabindex="0"
  role="button"
  aria-haspopup="dialog"
  aria-label={`Inspect ${name} (${status})`}
>
  <div class="node-main">
    <div class="node-icon-wrap" aria-hidden="true">
      <Icon name={icon} size={15} />
    </div>

    <div class="node-info">
      <div class="node-title-row">
        <span class="node-name font-mono">{name}</span>
        <div class="node-badges">
          {badge && <span class={`node-role-badge badge-${badge.toLowerCase()}`}>{badge}</span>}
          <span class={`node-status-dot status-${status}`} aria-hidden="true"></span>
        </div>
      </div>
      <div class="node-subtitle">{subtitle}</div>
    </div>
  </div>

  {port && (
    <div class="node-footer font-mono">
      <span class="node-port">{port}</span>
      <span class="node-hover-cta">INSPECT &rarr;</span>
    </div>
  )}
</div>

<style>
  .infra-node {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
    width: 100%;
    cursor: pointer;
    transition: 
      border-color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard),
      opacity var(--duration-fast) var(--ease-standard);
    outline: none;
    user-select: none;
    min-height: 44px;
    position: relative;
  }

  .infra-node:hover,
  .infra-node:focus-visible {
    border-color: var(--color-accent-primary);
    background: var(--color-surface-2);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), 0 0 14px rgba(25, 211, 230, 0.15);
  }

  .infra-node:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  :global(.infra-node.node-active) {
    border-color: var(--color-accent-primary) !important;
    background: var(--color-surface-2) !important;
    box-shadow: 0 0 18px rgba(25, 211, 230, 0.3) !important;
  }

  :global(.infra-node.node-connected) {
    border-color: rgba(92, 141, 255, 0.75) !important;
    background: rgba(92, 141, 255, 0.08) !important;
    box-shadow: 0 0 14px rgba(92, 141, 255, 0.2) !important;
  }

  :global(.infra-node.node-dimmed) {
    opacity: 0.3 !important;
  }

  :global(.infra-node.node-error-flash) {
    border-color: var(--color-danger) !important;
    box-shadow: 0 0 20px rgba(240, 93, 108, 0.75) !important;
    animation: pulse-dot-danger 1s infinite;
  }

  :global(.infra-node.node-promoted-flash) {
    border-color: var(--color-success) !important;
    box-shadow: 0 0 20px rgba(32, 211, 155, 0.75) !important;
    animation: pulse-dot 1s infinite;
  }

  :global(.infra-node.sonar-pulse) {
    animation: pulse-dot 0.8s ease-out;
  }

  .node-main {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .node-icon-wrap {
    color: var(--color-accent-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: rgba(25, 211, 230, 0.08);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .node-info {
    flex: 1;
    min-width: 0;
  }

  .node-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
  }

  .node-name {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: 0.02em;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .node-badges {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .node-role-badge {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 3px;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .badge-leader,
  .badge-master {
    background: rgba(32, 211, 155, 0.15);
    color: var(--color-success);
    border: 1px solid rgba(32, 211, 155, 0.3);
  }

  .badge-standby,
  .badge-sync,
  .badge-async {
    background: rgba(92, 141, 255, 0.15);
    color: var(--color-accent-secondary);
    border: 1px solid rgba(92, 141, 255, 0.3);
  }

  .badge-dcs {
    background: rgba(245, 185, 66, 0.15);
    color: var(--color-warning);
    border: 1px solid rgba(245, 185, 66, 0.3);
  }

  .badge-edge,
  .badge-gateway,
  .badge-compute,
  .badge-in-memory,
  .badge-pooler,
  .badge-storage,
  .badge-scraper,
  .badge-dashboard {
    background: rgba(25, 211, 230, 0.08);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .node-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .status-healthy,
  .status-operational {
    background: var(--color-success);
    box-shadow: 0 0 4px rgba(32, 211, 155, 0.7);
  }

  .status-active {
    background: var(--color-accent-primary);
    box-shadow: 0 0 4px rgba(25, 211, 230, 0.7);
  }

  .status-standby {
    background: var(--color-accent-secondary);
    box-shadow: 0 0 4px rgba(92, 141, 255, 0.7);
  }

  .node-subtitle {
    font-size: 0.64rem;
    color: var(--color-text-muted);
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 1px;
  }

  .node-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.62rem;
    padding-top: 3px;
    border-top: 1px dashed rgba(27, 48, 66, 0.6);
    margin-top: 2px;
  }

  .node-port {
    color: var(--color-text-muted);
  }

  .node-hover-cta {
    color: var(--color-accent-primary);
    font-weight: 700;
    opacity: 0.5;
    transition: opacity var(--duration-fast);
  }

  .infra-node:hover .node-hover-cta,
  .infra-node:focus-visible .node-hover-cta {
    opacity: 1;
  }

  /* Light Mode Specific Overrides */
  :global([data-theme="light"]) .infra-node {
    background: #FFFFFF;
    border-color: rgba(209, 217, 226, 0.9);
  }

  :global([data-theme="light"]) .infra-node:hover,
  :global([data-theme="light"]) .infra-node:focus-visible {
    box-shadow: 0 4px 14px #0000000f, 0 0 10px rgba(14, 165, 233, 0.12);
  }

  :global([data-theme="light"]) .node-footer {
    border-top-color: rgba(209, 217, 226, 0.85);
  }
</style>
