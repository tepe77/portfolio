---
import SectionHeader from '../common/SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectModal from './ProjectModal.astro';
import { projectsData } from '../../data/projects';

// Structured Bento Grid ordering:
// Row 1: PostgreSQL HA Cluster (span-2) + Observability Stack (span-1)
// Row 2: Object Storage & DR (span-1) + Automated CI/CD Platform (span-2)
// Row 3: ION Core Infrastructure (span-3, Panoramic Foundation)
const bentoLayoutConfig = [
  { id: 'postgres-ha', span: 'span-2' as const },
  { id: 'observability', span: 'span-1' as const },
  { id: 'object-storage', span: 'span-1' as const },
  { id: 'cicd-platform', span: 'span-2' as const },
  { id: 'ion-core', span: 'span-3' as const }
];

const bentoProjects = bentoLayoutConfig
  .map((config) => {
    const project = projectsData.find((p) => p.id === config.id);
    return project ? { project, span: config.span } : null;
  })
  .filter((item): item is { project: typeof projectsData[0]; span: 'span-1' | 'span-2' | 'span-3' } => item !== null);
---

<section id="projects" class="projects-section">
  <div class="container-wide">
    <SectionHeader
      eyebrow="03 // PROOF OF ENGINEERING"
      title="FEATURED CASE STUDIES"
      description="Engineered solutions detailing real-world operational challenges, high-availability database architectures, automated CI/CD gates, and measurable production telemetry."
    />

    <div class="projects-bento-grid">
      {bentoProjects.map(({ project, span }, index) => (
        <ProjectCard project={project} index={index} bentoSpan={span} />
      ))}
    </div>
  </div>

  <ProjectModal />
</section>

<style>
  .projects-section {
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  .projects-bento-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  /* Tablet: 2 columns */
  @media (min-width: 768px) and (max-width: 1099px) {
    .projects-bento-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Desktop: 3 columns Bento Grid */
  @media (min-width: 1100px) {
    .projects-bento-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
