---
import SectionHeader from '../common/SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectModal from './ProjectModal.astro';
import { projectsData } from '../../data/projects';

// Structured Bento Grid ordering:
// Row 1: PostgreSQL HA Cluster (span-2) + Observability Stack (span-1)
// Row 2: Object Storage & DR (span-1) + Automated CI/CD Platform (span-2)
// Row 3: ION Core Infrastructure (span-3, Panoramic Foundation)
const bentoLayoutConfig = [
  { id: 'postgres-ha', span: 'span-2' as const },
  { id: 'observability', span: 'span-1' as const },
  { id: 'object-storage', span: 'span-1' as const },
  { id: 'cicd-platform', span: 'span-2' as const },
  { id: 'ion-core', span: 'span-3' as const }
];

const bentoProjects = bentoLayoutConfig
  .map((config) => {
    const project = projectsData.find((p) => p.id === config.id);
    return project ? { project, span: config.span } : null;
  })
  .filter((item): item is { project: typeof projectsData[0]; span: 'span-1' | 'span-2' | 'span-3' } => item !== null);
---

<section id="projects" class="projects-section">
  <!-- Subtle Blueprint Grid & Soft Ambient Glow Backing -->
  <div class="projects-blueprint-grid" aria-hidden="true"></div>
  <div class="projects-ambient-glow" aria-hidden="true"></div>

  <div class="container-wide projects-container">
    <SectionHeader
      eyebrow="03 // PROOF OF ENGINEERING"
      title="FEATURED CASE STUDIES"
      description="Engineered solutions detailing real-world operational challenges, high-availability database architectures, automated CI/CD gates, and measurable production telemetry."
    />

    <div class="projects-bento-grid">
      {bentoProjects.map(({ project, span }, index) => (
        <ProjectCard project={project} index={index} bentoSpan={span} />
      ))}
    </div>
  </div>

  <ProjectModal />
</section>

<style>
  .projects-section {
    position: relative;
    width: 100%;
    max-width: 100%;
    padding-block: clamp(var(--space-12), 6vw, var(--space-20));
    overflow: hidden;
  }

  /* Subtle Blueprint Grid backdrop with top/bottom smooth gradient mask */
  .projects-blueprint-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, var(--bg-grid-color) 1px, transparent 1px),
      linear-gradient(to bottom, var(--bg-grid-color) 1px, transparent 1px);
    background-size: 44px 44px;
    background-position: center top;
    mask-image: linear-gradient(180deg, transparent 0%, black 12%, black 88%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, black 12%, black 88%, transparent 100%);
    pointer-events: none;
    z-index: 0;
    opacity: 0.75;
  }

  /* Soft Ambient Glow situated in the background */
  .projects-ambient-glow {
    position: absolute;
    top: 30%;
    right: 10%;
    width: min(720px, 85vw);
    height: 480px;
    background: radial-gradient(ellipse at center, rgba(92, 141, 255, 0.035) 0%, rgba(25, 211, 230, 0.015) 50%, transparent 72%);
    pointer-events: none;
    z-index: 0;
  }

  :global([data-theme="light"]) .projects-ambient-glow {
    background: radial-gradient(ellipse at center, rgba(37, 99, 235, 0.03) 0%, rgba(14, 165, 233, 0.012) 50%, transparent 72%);
  }

  .projects-container {
    position: relative;
    z-index: 1;
  }

  .projects-bento-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  /* Tablet: 2 columns */
  @media (min-width: 768px) and (max-width: 1099px) {
    .projects-bento-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Desktop: 3 columns Bento Grid */
  @media (min-width: 1100px) {
    .projects-bento-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
