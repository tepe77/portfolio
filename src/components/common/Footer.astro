---
import Icon from './Icon.astro';
import { profileData } from '../../data/profile';
---

<footer id="contact" class="site-footer">
  <div class="container footer-container">
    <!-- Transmission Header & Minimalist Command Hub -->
    <div class="footer-transmission" data-reveal>
      <div class="transmission-eyebrow font-mono text-xs">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>08 // INITIATE TRANSMISSION</span>
      </div>
      <h2 class="transmission-heading">LET'S BUILD RELIABLE SYSTEMS</h2>
      <p class="transmission-desc">
        Interested in infrastructure architecture, CI/CD automation, database reliability, or production operations? Reach out directly.
      </p>

      <!-- Minimalist Command Action Bar -->
      <div class="command-bar">
        <a
          href={`mailto:${profileData.email}`}
          class="cmd-btn cmd-btn-primary font-mono text-sm"
          aria-label="Send direct email to Prasaswo Tepe"
          title="Email Me Directly"
        >
          <Icon name="external-link" size={18} />
          <span class="cmd-text">EMAIL ME DIRECTLY</span>
        </a>

        <a
          href={profileData.github}
          target="_blank"
          rel="noopener noreferrer"
          class="cmd-btn cmd-btn-ghost font-mono text-sm"
          aria-label="Visit GitHub Profile"
          title="GitHub Profile"
        >
          <Icon name="git" size={18} />
          <span class="cmd-text">GITHUB</span>
        </a>

        <a
          href={profileData.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="cmd-btn cmd-btn-ghost font-mono text-sm"
          aria-label="Visit LinkedIn Profile"
          title="LinkedIn Profile"
        >
          <Icon name="globe" size={18} />
          <span class="cmd-text">LINKEDIN</span>
        </a>

        <a
          href={profileData.resumeUrl}
          download="prasaswo-tepe-resume.pdf"
          class="cmd-btn cmd-btn-ghost font-mono text-sm"
          aria-label="Download Resume PDF"
          title="Download Resume (PDF)"
        >
          <Icon name="download" size={18} />
          <span class="cmd-text">RESUME</span>
        </a>
      </div>
    </div>

    <div class="footer-divider" aria-hidden="true"></div>

    <!-- Bottom Metadata Bar -->
    <div class="footer-bottom">
      <div class="footer-creds font-mono text-xs text-muted">
        <span>BUILD &bull; AUTOMATE &bull; OBSERVE &bull; SCALE</span>
      </div>

      <div class="footer-copy font-mono text-xs text-muted">
        &copy; 2026 Prasaswo Tepe &bull; Built with Astro &bull; Deployed at the Edge
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-0);
    border-top: 1px solid var(--color-border);
    padding-top: clamp(var(--space-12), 6vw, var(--space-16));
    padding-bottom: var(--space-8);
    position: relative;
    z-index: var(--z-content);
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Transmission Area */
  .footer-transmission {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 760px;
    margin-inline: auto;
  }

  .transmission-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-accent-primary);
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: var(--space-2);
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-primary);
    box-shadow: 0 0 8px rgba(25, 211, 230, 0.6);
  }

  .transmission-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .transmission-desc {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 580px;
    margin-bottom: var(--space-6);
  }

  /* Command Action Bar */
  .command-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .cmd-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 18px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    text-decoration: none;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-standard);
    user-select: none;
    line-height: 1;
    white-space: nowrap;
    background: var(--color-surface-1);
    color: var(--color-text-primary);
    outline: none;
  }

  .cmd-btn:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  /* Variant: Primary */
  .cmd-btn-primary {
    background: var(--color-accent-primary);
    color: var(--color-bg-0);
    border-color: var(--color-accent-primary);
    box-shadow: 0 0 16px rgba(25, 211, 230, 0.2);
  }

  .cmd-btn-primary:hover {
    background: #5ce7f5;
    color: var(--color-bg-0);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(25, 211, 230, 0.35);
  }

  /* Variant: Ghost */
  .cmd-btn-ghost:hover {
    background: var(--color-surface-2);
    border-color: var(--color-border-hover);
  /* Divider */
  .footer-divider {
    height: 1px;
    background: rgba(27, 48, 66, 0.5);
  }

  /* Bottom Metadata */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 899px) {
    .site-footer {
      padding-bottom: calc(var(--space-8) + 56px + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (max-width: 640px) {
    .command-bar {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      flex-wrap: nowrap;
      gap: clamp(8px, 3vw, 14px);
      width: 100%;
      max-width: 100%;
    }

    .cmd-btn {
      width: 48px;
      height: 48px;
      min-width: 48px;
      min-height: 48px;
      padding: 0;
      border-radius: var(--radius-md);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .cmd-text,
    .cmd-btn span {
      display: none !important;
    }

    .cmd-btn :global(svg) {
      width: 20px;
      height: 20px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cmd-btn:hover {
      transform: none !important;
    }
  }
</style>
