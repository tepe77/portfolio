---
export interface Props {
  name: string;
  size?: number | string;
  class?: string;
  ariaLabel?: string;
}

const { name, size = 20, class: className = '', ariaLabel } = Astro.props;
const isAriaHidden = !ariaLabel;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`inline-icon ${className}`}
  aria-hidden={isAriaHidden ? 'true' : undefined}
  aria-label={ariaLabel}
  focusable="false"
>
  {name === 'docker' && (
    <g>
      <path d="M4 12h16c.6 0 1 .4 1 1 0 4-3.5 7-9 7s-9-3-9-7c0-.6.4-1 1-1Z" />
      <path d="M5 9h3v3H5zM9 9h3v3H9zM13 9h3v3h-3zM9 6h3v3H9zM13 6h3v3h-3z" />
      <circle cx="17.5" cy="15.5" r=".5" fill="currentColor" />
    </g>
  )}

  {name === 'git' && (
    <g>
      <circle cx="18" cy="18" r="3" />
      <circle cx="6" cy="6" r="3" />
      <circle cx="6" cy="18" r="3" />
      <path d="M18 9a9 9 0 0 1-9 9" />
      <line x1="6" y1="9" x2="6" y2="15" />
    </g>
  )}

  {name === 'database' && (
    <g>
      <ellipse cx="12" cy="5" rx="9" ry="3" />
      <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
      <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
    </g>
  )}

  {name === 'server' && (
    <g>
      <rect width="20" height="8" x="2" y="2" rx="2" ry="2" />
      <rect width="20" height="8" x="2" y="14" rx="2" ry="2" />
      <line x1="6" y1="6" x2="6.01" y2="6" />
      <line x1="6" y1="18" x2="6.01" y2="18" />
    </g>
  )}

  {name === 'terminal' && (
    <g>
      <polyline points="4 17 10 11 4 5" />
      <line x1="12" y1="19" x2="20" y2="19" />
    </g>
  )}

  {name === 'cloud' && (
    <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
  )}

  {name === 'activity' && (
    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
  )}

  {name === 'chart' && (
    <g>
      <line x1="18" y1="20" x2="18" y2="10" />
      <line x1="12" y1="20" x2="12" y2="4" />
      <line x1="6" y1="20" x2="6" y2="14" />
    </g>
  )}

  {name === 'shield' && (
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
  )}

  {name === 'lock' && (
    <g>
      <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
      <path d="M7 11V7a5 5 0 0 1 10 0v4" />
    </g>
  )}

  {name === 'globe' && (
    <g>
      <circle cx="12" cy="12" r="10" />
      <line x1="2" y1="12" x2="22" y2="12" />
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
    </g>
  )}

  {name === 'layers' && (
    <g>
      <polygon points="12 2 2 7 12 12 22 7 12 2" />
      <polyline points="2 17 12 22 22 17" />
      <polyline points="2 12 12 17 22 12" />
    </g>
  )}

  {name === 'network' && (
    <g>
      <rect width="6" height="6" x="9" y="2" rx="1" />
      <rect width="6" height="6" x="2" y="16" rx="1" />
      <rect width="6" height="6" x="16" y="16" rx="1" />
      <path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3" />
      <line x1="12" y1="12" x2="12" y2="8" />
    </g>
  )}

  {name === 'refresh' && (
    <g>
      <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67" />
    </g>
  )}

  {name === 'check-circle' && (
    <g>
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
      <polyline points="22 4 12 14.01 9 11.01" />
    </g>
  )}

  {name === 'arrow-right' && (
    <g>
      <line x1="5" y1="12" x2="19" y2="12" />
      <polyline points="12 5 19 12 12 19" />
    </g>
  )}

  {name === 'arrow-up' && (
    <g>
      <line x1="12" y1="19" x2="12" y2="5" />
      <polyline points="5 12 12 5 19 12" />
    </g>
  )}

  {name === 'arrow-up-right' && (
    <g>
      <line x1="7" y1="17" x2="17" y2="7" />
      <polyline points="7 7 17 7 17 17" />
    </g>
  )}

  {name === 'copy' && (
    <g>
      <rect width="13" height="13" x="9" y="9" rx="2" ry="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </g>
  )}

  {name === 'external-link' && (
    <g>
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
      <polyline points="15 3 21 3 21 9" />
      <line x1="10" y1="14" x2="21" y2="3" />
    </g>
  )}

  {name === 'download' && (
    <g>
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
      <polyline points="7 10 12 15 17 10" />
      <line x1="12" y1="15" x2="12" y2="3" />
    </g>
  )}

  {name === 'menu' && (
    <g>
      <line x1="4" y1="6" x2="20" y2="6" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="18" x2="20" y2="18" />
    </g>
  )}

  {name === 'close' && (
    <g>
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </g>
  )}

  {name === 'search' && (
    <g>
      <circle cx="11" cy="11" r="8" />
      <line x1="21" y1="21" x2="16.65" y2="16.65" />
    </g>
  )}

  {name === 'cpu' && (
    <g>
      <rect width="16" height="16" x="4" y="4" rx="2" />
      <rect width="6" height="6" x="9" y="9" rx="1" />
      <path d="M15 2v2M9 2v2M20 15h2M20 9h2M9 20v2M15 20v2M2 9h2M2 15h2" />
    </g>
  )}

  {name === 'zap' && (
    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
  )}
</svg>

<style>
  .inline-icon {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }
</style>
