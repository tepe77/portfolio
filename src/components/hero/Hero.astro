---
import Button from '../common/Button.astro';
import Icon from '../common/Icon.astro';
import HeroTopology from './HeroTopology.astro';
import HeroMetrics from './HeroMetrics.astro';
import HeroDeploymentCanvas from './HeroDeploymentCanvas.astro';
import { profileData } from '../../data/profile';
---

<section id="hero" class="hero-section">
  <!-- Minimalist 3D Deployment Flow Canvas Background -->
  <HeroDeploymentCanvas />

  <div class="container-wide hero-container">
    <!-- Left Column: Identity & Value Proposition (6 columns) -->
    <div class="hero-content" data-reveal>
      <div class="hero-eyebrow font-mono">
        <span class="eyebrow-slash">//</span>
        <span>{profileData.eyebrow}</span>
        <span class="eyebrow-name">{profileData.name}</span>
      </div>

      <h1 class="hero-title">
        <span class="title-row-1">
          <span class="text-gradient">DEVOPS</span>
          <span class="title-ampersand">&amp;</span>
        </span>
        <span class="title-row-2 text-gradient-secondary">INFRASTRUCTURE</span>
        <span class="title-row-3 title-suffix">ENGINEERING</span>
      </h1>

      <p class="hero-description">
        {profileData.summary}
      </p>

      <div class="hero-cta-group">
        <Button href="#projects" variant="primary" size="md">
          EXPLORE MY WORK
          <Icon name="arrow-right" size={16} />
        </Button>

        <Button href={profileData.resumeUrl} variant="secondary" size="md" download="prasaswo-tepe-resume.pdf">
          <Icon name="download" size={16} />
          DOWNLOAD RESUME
        </Button>
      </div>

      <!-- Live simulated metrics -->
      <HeroMetrics />
    </div>

    <!-- Right Column: Interactive Topology Preview (6 columns) -->
    <div class="hero-visual">
      <HeroTopology />
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: auto;
    display: flex;
    align-items: center;
    padding-top: clamp(100px, 14vw, 190px);
    padding-bottom: clamp(60px, 8vw, 130px);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--space-8);
      align-items: center;
    }

    .hero-content {
      grid-column: span 6;
    }

    .hero-visual {
      grid-column: span 6;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent-primary);
    letter-spacing: 0.12em;
    margin-bottom: var(--space-3);
  }

  .eyebrow-slash {
    color: var(--color-text-muted);
  }

  .eyebrow-name {
    color: var(--color-text-primary);
    border-left: 1px solid var(--color-border);
    padding-left: var(--space-2);
  }

  .hero-title {
    font-size: clamp(1.85rem, 5.5vw, 3.25rem);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.025em;
    margin-bottom: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 2px;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .title-row-1 {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .text-gradient {
    background: linear-gradient(135deg, #FFFFFF 30%, var(--color-accent-primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .title-ampersand {
    font-size: 0.85em;
    color: var(--color-accent-primary);
    font-weight: 300;
  }

  .text-gradient-secondary {
    background: linear-gradient(135deg, #E6EDF3 40%, var(--color-accent-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .title-suffix {
    color: var(--color-text-primary);
  }

  .hero-description {
    font-size: clamp(0.925rem, 1.15vw, 1.05rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 100%;
    margin-bottom: var(--space-5);
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .hero-visual {
    width: 100%;
  }

  @media (max-width: 640px) {
    .hero-section {
      padding-top: clamp(100px, 16vw, 130px);
      padding-bottom: clamp(64px, 12vw, 90px);
    }

    .hero-cta-group {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
