---
import Icon from './Icon.astro';
---

<div id="command-palette-modal" class="command-palette-modal" role="dialog" aria-modal="true" aria-label="Command Palette" aria-hidden="true">
  <div class="command-dialog">
    <div class="command-search-bar">
      <span class="search-icon" aria-hidden="true">
        <Icon name="search" size={18} />
      </span>
      <input
        type="text"
        id="command-palette-input"
        class="command-input"
        placeholder="Type a command or search sections..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="esc-badge">ESC</kbd>
    </div>

    <div id="command-palette-list" class="command-list" role="listbox">
      <!-- Dynamic list populated via command-palette.ts -->
    </div>

    <div class="command-footer">
      <div class="keyboard-hints">
        <span><kbd>↑</kbd> <kbd>↓</kbd> to navigate</span>
        <span><kbd>↵</kbd> to select</span>
        <span><kbd>esc</kbd> to dismiss</span>
      </div>
      <div class="palette-brand font-mono">PRASASWO.TEPE // CONSOLE</div>
    </div>
  </div>
</div>

<style>
  .command-palette-modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-command-palette);
    background: rgba(6, 11, 18, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: clamp(60px, 15vh, 140px);
    padding-inline: var(--space-4);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .command-palette-modal.open {
    opacity: 1;
    pointer-events: auto;
  }

  .command-dialog {
    width: min(100%, 640px);
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6), 0 0 32px rgba(25, 211, 230, 0.1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 70vh;
  }

  .command-search-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-2);
  }

  .search-icon {
    color: var(--color-accent-primary);
    display: flex;
    align-items: center;
  }

  .command-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-sans);
    font-size: var(--text-md);
    color: var(--color-text-primary);
  }

  .command-input::placeholder {
    color: var(--color-text-muted);
  }

  .esc-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 3px 6px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .command-list {
    overflow-y: auto;
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  :global(.command-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    text-align: left;
    cursor: pointer;
    transition: background var(--duration-fast), border-color var(--duration-fast);
  }

  :global(.command-item:hover),
  :global(.command-item.selected) {
    background: var(--color-surface-2);
    border-color: var(--color-border-hover);
  }

  :global(.command-text-wrapper) {
    display: flex;
    flex-direction: column;
  }

  :global(.command-label) {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  :global(.command-category) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent-primary);
    margin-top: 2px;
  }

  :global(.command-shortcut) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  :global(.command-empty) {
    padding: var(--space-8);
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-family: var(--font-mono);
  }

  .command-footer {
    padding: var(--space-3) var(--space-5);
    background: var(--color-bg-0);
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .keyboard-hints {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .keyboard-hints kbd {
    font-family: var(--font-mono);
    padding: 2px 5px;
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: 3px;
  }

  .palette-brand {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .command-palette-modal {
      padding-top: 14px;
      padding-inline: var(--space-3);
    }

    .command-dialog {
      width: 100%;
      max-height: 85dvh;
    }

    .keyboard-hints span:not(:first-child) {
      display: none;
    }
  }
</style>
