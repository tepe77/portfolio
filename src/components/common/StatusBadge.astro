---
export interface Props {
  status?: "operational" | "healthy" | "warning" | "danger" | "info";
  label?: string;
  size?: "sm" | "md";
  class?: string;
}

const {
  status = "operational",
  label = "ALL SYSTEMS OPERATIONAL",
  size = "md",
  class: className = ""
} = Astro.props;
---

<div class={`status-badge status-${status} size-${size} ${className}`} role="status">
  <span class="status-dot" aria-hidden="true"></span>
  <span class="status-text">{label}</span>
</div>

<style>
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    user-select: none;
    transition: background-color var(--duration-fast), border-color var(--duration-fast);
  }

  .size-sm {
    padding: 3px 10px;
    font-size: var(--text-xs);
  }

  .size-md {
    padding: 6px 14px;
    font-size: 0.75rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Operational / Healthy */
  .status-operational,
  .status-healthy {
    background: rgba(32, 211, 155, 0.08);
    border: 1px solid rgba(32, 211, 155, 0.25);
    color: var(--color-success);
  }
  .status-operational .status-dot,
  .status-healthy .status-dot {
    background: var(--color-success);
    animation: pulse-dot 2.5s infinite;
  }

  /* Warning */
  .status-warning {
    background: rgba(245, 185, 66, 0.08);
    border: 1px solid rgba(245, 185, 66, 0.25);
    color: var(--color-warning);
  }
  .status-warning .status-dot {
    background: var(--color-warning);
    animation: pulse-dot-warning 2.5s infinite;
  }

  /* Danger */
  .status-danger {
    background: rgba(240, 93, 108, 0.08);
    border: 1px solid rgba(240, 93, 108, 0.25);
    color: var(--color-danger);
  }
  .status-danger .status-dot {
    background: var(--color-danger);
    animation: pulse-dot-danger 2.5s infinite;
  }

  /* Info */
  .status-info {
    background: rgba(25, 211, 230, 0.08);
    border: 1px solid rgba(25, 211, 230, 0.25);
    color: var(--color-accent-primary);
  }
  .status-info .status-dot {
    background: var(--color-accent-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot {
      animation: none !important;
    }
  }
</style>
