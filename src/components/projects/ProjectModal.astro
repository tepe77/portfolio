---
import Icon from '../common/Icon.astro';
---

<dialog id="project-modal" class="project-modal" aria-labelledby="modal-project-title">
  <div class="modal-wrapper">
    <div class="modal-header">
      <div class="modal-title-group">
        <span id="modal-project-category" class="modal-category font-mono text-xs">PRODUCTION ARCHITECTURE</span>
        <h2 id="modal-project-title" class="modal-title">Case Study Title</h2>
      </div>

      <button type="button" id="project-modal-close" class="modal-close-btn" aria-label="Close case study dialog">
        <Icon name="close" size={24} />
      </button>
    </div>

    <div class="modal-content">
      <p id="modal-project-desc" class="modal-lead"></p>

      <!-- Problem & Solution Comparison -->
      <div class="problem-solution-grid">
        <div class="ps-card ps-problem">
          <div class="ps-header font-mono">
            <span class="ps-indicator dot-red"></span>
            <span>THE CHALLENGE / BOTTLENECK</span>
          </div>
          <p id="modal-project-problem" class="ps-text"></p>
        </div>

        <div class="ps-card ps-solution">
          <div class="ps-header font-mono">
            <span class="ps-indicator dot-green"></span>
            <span>ENGINEERED ARCHITECTURE</span>
          </div>
          <p id="modal-project-solution" class="ps-text"></p>
        </div>
      </div>

      <!-- Architecture Pipeline Steps -->
      <div class="modal-section">
        <h3 class="modal-section-title font-mono text-xs">
          <span>//</span> ARCHITECTURE &amp; DATA PIPELINE
        </h3>
        <ul id="modal-project-arch" class="modal-arch-steps font-mono"></ul>
      </div>

      <!-- Verified Metrics -->
      <div class="modal-section">
        <h3 class="modal-section-title font-mono text-xs">
          <span>//</span> VERIFIED ENGINEERING METRICS
        </h3>
        <div id="modal-project-metrics" class="modal-metrics-grid"></div>
      </div>

      <!-- Highlights -->
      <div class="modal-section">
        <h3 class="modal-section-title font-mono text-xs">
          <span>//</span> KEY ENGINEERING DECISIONS
        </h3>
        <ul id="modal-project-highlights" class="modal-bullets"></ul>
      </div>

      <!-- Technologies Used -->
      <div class="modal-section">
        <h3 class="modal-section-title font-mono text-xs">
          <span>//</span> STACK &amp; TOOLING
        </h3>
        <div id="modal-project-tech" class="modal-tech-pills"></div>
      </div>
    </div>

    <div class="modal-footer">
      <span class="modal-footer-note font-mono text-xs text-muted">
        Case study architecture verified and sanitized for public presentation.
      </span>
    </div>
  </div>
</dialog>

<style>
  .project-modal {
    margin: auto;
    width: min(900px, 92vw);
    max-height: 88vh;
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.7), 0 0 32px rgba(25, 211, 230, 0.12);
    color: var(--color-text-primary);
    overflow: hidden;
    padding: 0;
  }

  .project-modal::backdrop {
    background: rgba(6, 11, 18, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .modal-wrapper {
    display: flex;
    flex-direction: column;
    max-height: 88vh;
  }

  .modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: var(--space-6) var(--space-8);
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .modal-category {
    color: var(--color-accent-primary);
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .modal-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    color: var(--color-text-primary);
    margin-top: var(--space-1);
  }

  .modal-close-btn {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    cursor: pointer;
    padding: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--duration-fast);
  }

  .modal-close-btn:hover {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  .modal-content {
    padding: var(--space-6) var(--space-8);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .modal-lead {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .problem-solution-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .problem-solution-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ps-card {
    background: var(--color-bg-0);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
  }

  .ps-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
  }

  .ps-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot-red { background: var(--color-danger); }
  .dot-green { background: var(--color-success); }

  .ps-problem .ps-header { color: var(--color-danger); }
  .ps-solution .ps-header { color: var(--color-success); }

  .ps-text {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 0;
  }

  .modal-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .modal-section-title {
    color: var(--color-accent-primary);
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  :global(.modal-arch-steps) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  :global(.modal-arch-steps li) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-0);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text-primary);
  }

  :global(.modal-arch-steps .step-num) {
    color: var(--color-accent-primary);
    font-weight: 700;
  }

  :global(.modal-metrics-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-3);
  }

  :global(.modal-metric-card) {
    background: var(--color-bg-0);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
  }

  :global(.modal-metric-card .metric-val) {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-success);
  }

  :global(.modal-metric-card .metric-lbl) {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  :global(.modal-bullets) {
    list-style-position: inside;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  :global(.modal-bullets li) {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  :global(.modal-tech-pills) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .modal-footer {
    padding: var(--space-4) var(--space-8);
    background: var(--color-surface-2);
    border-top: 1px solid var(--color-border);
  }
</style>
