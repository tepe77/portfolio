---
import Icon from '../common/Icon.astro';
import TechLogo from './TechLogo.astro';
import TechnologyDrawer from './TechnologyDrawer.astro';
import { domainList, stackData } from '../../data/stack';

const techMap = new Map(stackData.map((t) => [t.id, t]));
const initialTech = stackData.find((t) => t.id === 'docker') || stackData[0];
---

<section id="stack" class="stack-section">
  <div class="container-wide">
    <div class="editorial-stack-layout">
      <!-- ================= 1. LEFT: SECTION INTRO ================= -->
      <div class="stack-intro-col" data-reveal>
        <div class="intro-content">
          <span class="eyebrow font-mono">05 // TECH STACK &amp; CAPABILITIES</span>
          <h2 class="section-title">CORE TECHNOLOGIES</h2>
          <p class="section-desc">
            Production-tested technologies across infrastructure, automation, delivery, observability, and data.
            Explore each technology to see how it is applied in real production environments.
          </p>
        </div>

        <div class="intro-bottom">
          <div class="intro-divider" aria-hidden="true"></div>
          <div class="interaction-hint font-mono text-xs">
            <span class="hint-icon" aria-hidden="true">ⓘ</span>
            <span class="hint-text">
              Click a technology chip to view detailed information and real-world usage.
            </span>
          </div>
        </div>
      </div>

      <!-- ================= 2. CENTER: TECHNOLOGY DOMAINS ================= -->
      <div class="stack-domains-col" data-reveal data-reveal-delay={60}>
        <div class="domains-grid">
          {domainList.map((domain) => (
            <div class="domain-card">
              <div class="domain-card-header">
                <span class="domain-icon-wrap" aria-hidden="true">
                  <Icon name={domain.icon} size={18} />
                </span>
                <h3 class="domain-card-title">{domain.name}</h3>
              </div>

              <div class="domain-chips-wrap" role="group" aria-label={`${domain.name} technologies`}>
                {domain.technologies.map((techId) => {
                  const tech = techMap.get(techId);
                  if (!tech) return null;
                  const isDefault = tech.id === initialTech.id;
                  return (
                    <button
                      type="button"
                      class={`tech-chip ${isDefault ? 'active' : ''}`}
                      data-tech-id={tech.id}
                      aria-pressed={isDefault ? 'true' : 'false'}
                    >
                      <TechLogo name={tech.id} size={15} class="chip-logo" />
                      <span class="chip-name">{tech.name}</span>
                    </button>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- ================= 3. RIGHT: DETAIL PANEL ================= -->
      <div class="stack-detail-col" data-reveal data-reveal-delay={120}>
        <div class="tech-detail-panel" id="tech-detail-panel" role="region" aria-label="Technology details">
          <!-- Top Area: Header & Desc -->
          <div class="detail-top-group">
            <div class="detail-header">
              <div class="detail-meta">
                <div class="detail-icon-wrap" id="detail-icon-wrap" aria-hidden="true">
                  <TechLogo name={initialTech.id} size={32} />
                </div>
                <div>
                  <h3 class="detail-title" id="detail-title">{initialTech.name}</h3>
                  <span class="detail-category font-mono text-xs" id="detail-category">
                    {initialTech.category}
                  </span>
                </div>
              </div>
              <button
                type="button"
                class="detail-reset-btn"
                id="detail-reset-btn"
                aria-label="Reset selection"
                title="Reset selection"
              >
                &times;
              </button>
            </div>

            <!-- Description -->
            <p class="detail-desc" id="detail-desc">
              {initialTech.description}
            </p>

            <!-- Specifications Table -->
            <div class="detail-specs-block">
              <div class="specs-grid" id="detail-specs">
                {initialTech.specs.map((spec) => (
                  <div class="spec-row">
                    <span class="spec-key font-mono text-xs">{spec.label}</span>
                    <span class="spec-val font-mono text-xs">{spec.value}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Related Projects -->
            <div class="detail-projects-block">
              <span class="projects-label font-mono text-xs">Related projects</span>
              <ul class="projects-list" id="detail-projects-list">
                {initialTech.relatedProjects.map((proj) => (
                  <li>{proj}</li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Bottom Area: CTA Button -->
          <div class="detail-footer">
            <button
              type="button"
              id="detail-cta-btn"
              class="detail-cta-btn font-mono"
              data-open-tech={initialTech.id}
            >
              <span>View full specs</span>
              <span class="cta-arrow" aria-hidden="true">&rarr;</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <TechnologyDrawer />

  <!-- Hidden Icon Store for dynamic detail panel icon rendering -->
  <div id="tech-icons-store" style="display: none;" aria-hidden="true">
    {stackData.map((tech) => (
      <div data-icon-for={tech.id}>
        <TechLogo name={tech.id} size={32} />
      </div>
    ))}
  </div>
</section>

<script>
  import { stackData } from '../../data/stack';

  function initTechStack() {
    const chips = document.querySelectorAll<HTMLButtonElement>('.tech-chip');
    const titleEl = document.getElementById('detail-title');
    const catEl = document.getElementById('detail-category');
    const descEl = document.getElementById('detail-desc');
    const specsEl = document.getElementById('detail-specs');
    const projectsListEl = document.getElementById('detail-projects-list');
    const iconWrapEl = document.getElementById('detail-icon-wrap');
    const ctaBtn = document.getElementById('detail-cta-btn') as HTMLButtonElement | null;
    const resetBtn = document.getElementById('detail-reset-btn');

    if (!titleEl || !descEl || !specsEl || !projectsListEl) return;

    function renderTech(techId: string) {
      const tech = stackData.find((t) => t.id === techId);
      if (!tech) return;

      // Update active state on all chips
      chips.forEach((c) => {
        const isActive = c.dataset.techId === techId;
        c.classList.toggle('active', isActive);
        c.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      // Update Authentic Brand Logo Icon
      const storedIcon = document.querySelector<HTMLElement>(`[data-icon-for="${techId}"]`);
      if (storedIcon && iconWrapEl) {
        iconWrapEl.innerHTML = storedIcon.innerHTML;
      }

      // Update Text Details
      titleEl.textContent = tech.name;
      if (catEl) catEl.textContent = tech.category;
      descEl.textContent = tech.description;

      // Update Key-Value Specifications
      specsEl.innerHTML = tech.specs
        .map(
          (s) => `
          <div class="spec-row">
            <span class="spec-key font-mono text-xs">${s.label}</span>
            <span class="spec-val font-mono text-xs">${s.value}</span>
          </div>`
        )
        .join('');

      // Update Related Projects
      projectsListEl.innerHTML = tech.relatedProjects
        .map((p) => `<li>${p}</li>`)
        .join('');

      // Update CTA trigger
      if (ctaBtn) {
        ctaBtn.dataset.openTech = tech.id;
      }
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const id = chip.dataset.techId;
        if (id) {
          renderTech(id);
          // On mobile screens where detail panel is stacked below, smoothly scroll down so user sees details
          if (window.innerWidth < 1080) {
            const detailPanel = document.getElementById('tech-detail-panel');
            if (detailPanel) {
              detailPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          }
        }
      });
    });

    resetBtn?.addEventListener('click', () => {
      renderTech('docker');
    });

    // Re-bind CTA click to open TechnologyDrawer if needed
    ctaBtn?.addEventListener('click', () => {
      const id = ctaBtn.dataset.openTech;
      const targetTrigger = document.querySelector<HTMLElement>(`[data-open-tech="${id}"]`);
      if (targetTrigger && targetTrigger !== ctaBtn) {
        targetTrigger.click();
      }
    });
  }

  initTechStack();
  document.addEventListener('astro:page-load', initTechStack);
</script>

<style>
  .stack-section {
    position: relative;
    padding-block: clamp(var(--space-12), 6vw, var(--space-20));
  }

  /* 3-Part Editorial Grid Layout with 100% Equal Height */
  .editorial-stack-layout {
    display: grid;
    grid-template-columns: 290px 1.25fr 360px;
    gap: var(--space-6);
    align-items: stretch; /* All 3 columns stretch equally */
  }

  /* ================= 1. LEFT INTRO ================= */
  .stack-intro-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding-block: var(--space-2);
  }

  .intro-content {
    display: flex;
    flex-direction: column;
  }

  .eyebrow {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: var(--space-2);
  }

  .section-title {
    font-size: clamp(1.75rem, 2.5vw, 2.35rem);
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: var(--space-4);
  }

  .section-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .intro-bottom {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-6);
  }

  .intro-divider {
    width: 44px;
    height: 2px;
    background: rgba(27, 48, 66, 0.7);
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-5);
  }

  .interaction-hint {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .hint-icon {
    color: var(--color-accent-primary);
    font-size: 1rem;
    line-height: 1;
    flex-shrink: 0;
  }

  /* ================= 2. CENTER DOMAINS GRID ================= */
  .stack-domains-col {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .domains-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 1fr; /* All domain cards share the exact same equal height */
    gap: var(--space-4);
    height: 100%;
  }

  .domain-card {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: var(--space-3);
    height: 100%;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .domain-card:hover {
    border-color: rgba(25, 211, 230, 0.35);
  }

  .domain-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .domain-icon-wrap {
    color: var(--color-accent-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: rgba(25, 211, 230, 0.08);
    border: 1px solid rgba(25, 211, 230, 0.18);
    flex-shrink: 0;
  }

  .domain-card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  .domain-chips-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: var(--space-1);
  }

  /* Interactive Technology Chip with Authentic Logo */
  .tech-chip {
    background: rgba(13, 22, 34, 0.9);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 6px 12px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-standard);
    user-select: none;
    line-height: 1.3;
    outline: none;
  }

  .tech-chip:hover {
    border-color: var(--color-accent-primary);
    color: var(--color-text-primary);
    background: var(--color-surface-2);
  }

  .tech-chip:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  /* Active / Selected Chip: High contrast filled pill */
  .tech-chip.active {
    background: #FFFFFF;
    color: #060B12;
    border-color: #FFFFFF;
    font-weight: 700;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), 0 0 12px rgba(255, 255, 255, 0.2);
  }

  .tech-chip.active .chip-name {
    color: #060B12;
  }

  /* ================= 3. RIGHT DETAIL PANEL ================= */
  .stack-detail-col {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .tech-detail-panel {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%; /* Stretches to match center grid height perfectly */
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35);
  }

  .detail-top-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .detail-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid rgba(27, 48, 66, 0.6);
  }

  .detail-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .detail-icon-wrap {
    color: var(--color-accent-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: rgba(16, 26, 38, 0.8);
    border: 1px solid rgba(27, 48, 66, 0.8);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }

  .detail-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.2;
  }

  .detail-category {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .detail-reset-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 4px;
    transition: color var(--duration-fast);
  }

  .detail-reset-btn:hover {
    color: var(--color-accent-primary);
  }

  .detail-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Specifications Key-Value */
  .detail-specs-block {
    background: rgba(6, 11, 18, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }

  .specs-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .spec-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .spec-key {
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .spec-val {
    color: var(--color-text-primary);
    text-align: right;
    word-break: break-word;
  }

  /* Related Projects */
  .detail-projects-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .projects-label {
    font-weight: 700;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .projects-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .projects-list li {
    font-size: 0.8125rem;
    color: var(--color-accent-primary);
    position: relative;
    padding-left: 14px;
  }

  .projects-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-text-muted);
  }

  /* Detail CTA */
  .detail-footer {
    padding-top: var(--space-4);
  }

  .detail-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    min-height: 44px;
    background: #060B12;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-standard);
    outline: none;
  }

  .detail-cta-btn:hover {
    background: var(--color-surface-2);
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), 0 0 16px rgba(25, 211, 230, 0.15);
  }

  .detail-cta-btn:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .cta-arrow {
    transition: transform var(--duration-fast);
  }

  .detail-cta-btn:hover .cta-arrow {
    transform: translateX(3px);
  }

  /* ================= RESPONSIVE BEHAVIOR ================= */
  @media (max-width: 1240px) {
    .editorial-stack-layout {
      grid-template-columns: 260px 1.2fr 320px;
      gap: var(--space-4);
    }
  }

  @media (max-width: 1080px) {
    .editorial-stack-layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      align-items: start;
    }

    .stack-intro-col {
      height: auto;
    }

    .domains-grid {
      grid-auto-rows: auto;
    }

    .tech-detail-panel {
      height: auto;
    }
  }

  @media (max-width: 640px) {
    .domains-grid {
      grid-template-columns: 1fr;
    }

    .editorial-stack-layout {
      gap: var(--space-6);
    }
  }

  @media (max-width: 480px) {
    .editorial-intro-card,
    .domain-card,
    .tech-detail-panel {
      padding: var(--space-4);
    }

    .domain-title {
      font-size: 0.95rem;
    }

    .tech-chip {
      padding: 6px 10px;
      font-size: 0.78rem;
      min-height: 38px;
    }

    .detail-header {
      gap: var(--space-2);
    }

    .detail-icon-wrap {
      width: 40px;
      height: 40px;
    }

    .detail-title {
      font-size: 1.15rem;
    }

    .detail-specs-block {
      padding: var(--space-3);
    }

    .spec-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }

    .spec-val {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-chip,
    .detail-cta-btn,
    .cta-arrow {
      transition: none !important;
    }
  }
</style>
