---
// Interactive Constellation Server Mesh Canvas
// Pure HTML5 Canvas 2D: Node & Beam Network Topology with Live Packet Flow
// High performance, zero external dependencies, responsive with battery optimization
---

<div class="hero-deployment-canvas-wrapper" aria-hidden="true">
  <canvas id="hero-deployment-canvas" class="hero-canvas"></canvas>
  <div class="canvas-vignette"></div>
</div>

<script>
  function initHeroConstellationCanvas() {
    const canvas = document.getElementById('hero-deployment-canvas') as HTMLCanvasElement | null;
    const wrapper = document.querySelector('.hero-deployment-canvas-wrapper') as HTMLElement | null;
    if (!canvas || !wrapper) return;

    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let animFrameId: number | null = null;
    let isVisible = true;

    interface NodePoint {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      color: string;
      colorRgb: string;
      baseAlpha: number;
      phase: number;
      isHub: boolean;
    }

    interface DataPacket {
      fromIdx: number;
      toIdx: number;
      progress: number;
      speed: number;
      color: string;
    }

    const palette = [
      { hex: '#19D3E6', rgb: '25, 211, 230' },  // Primary Cyan
      { hex: '#38BDF8', rgb: '56, 189, 248' },  // Sky Blue
      { hex: '#5C8DFF', rgb: '92, 141, 255' },  // Electric Indigo
      { hex: '#20D39B', rgb: '32, 211, 155' }   // Emerald Green
    ];

    let nodes: NodePoint[] = [];
    let packets: DataPacket[] = [];
    let time = 0;
    let packetTimer = 0;

    const mouse = {
      x: -1000,
      y: -1000,
      active: false
    };

    // Calculate dynamic node count based on screen area
    const initNodes = () => {
      nodes = [];
      packets = [];
      const area = width * height;
      const count = Math.min(Math.max(Math.floor(area / 16000), 32), 65);

      for (let i = 0; i < count; i++) {
        const pal = palette[Math.floor(Math.random() * palette.length)];
        const isHub = Math.random() < 0.22;
        nodes.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.45,
          vy: (Math.random() - 0.5) * 0.45,
          radius: isHub ? (Math.random() * 0.8 + 2.4) : (Math.random() * 0.8 + 1.4),
          color: pal.hex,
          colorRgb: pal.rgb,
          baseAlpha: isHub ? 0.85 : (Math.random() * 0.35 + 0.35),
          phase: Math.random() * Math.PI * 2,
          isHub
        });
      }
    };

    const resize = () => {
      const rect = wrapper.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      ctx.scale(dpr, dpr);
      initNodes();
    };

    const spawnDataPacket = () => {
      if (nodes.length < 2 || packets.length > 12) return;
      const fromIdx = Math.floor(Math.random() * nodes.length);
      const fromNode = nodes[fromIdx];

      // Find a near connected neighbor
      let bestToIdx = -1;
      let minDistance = Infinity;

      for (let j = 0; j < nodes.length; j++) {
        if (j === fromIdx) continue;
        const dx = nodes[j].x - fromNode.x;
        const dy = nodes[j].y - fromNode.y;
        const dSq = dx * dx + dy * dy;
        if (dSq < 135 * 135 && dSq < minDistance) {
          minDistance = dSq;
          bestToIdx = j;
        }
      }

      if (bestToIdx !== -1) {
        packets.push({
          fromIdx,
          toIdx: bestToIdx,
          progress: 0,
          speed: Math.random() * 0.018 + 0.014,
          color: fromNode.color
        });
      }
    };

    const render = () => {
      if (!ctx || width === 0 || height === 0) return;

      time += 0.025;
      packetTimer++;
      if (packetTimer % 18 === 0) {
        spawnDataPacket();
      }

      ctx.clearRect(0, 0, width, height);

      const maxLinkDist = 130;
      const maxLinkDistSq = maxLinkDist * maxLinkDist;
      const maxMouseDist = 150;
      const maxMouseDistSq = maxMouseDist * maxMouseDist;

      // 1. Update node physics
      for (let i = 0; i < nodes.length; i++) {
        const node = nodes[i];

        if (mouse.active) {
          const dx = mouse.x - node.x;
          const dy = mouse.y - node.y;
          const distSq = dx * dx + dy * dy;

          if (distSq < maxMouseDistSq) {
            const dist = Math.sqrt(distSq);
            const force = (1 - dist / maxMouseDist) * 0.035;
            node.vx += (dx / dist) * force;
            node.vy += (dy / dist) * force;
          }
        }

        node.vx *= 0.985;
        node.vy *= 0.985;

        // Maintain gentle base drift
        const speed = Math.hypot(node.vx, node.vy);
        if (speed < 0.15) {
          node.vx += (Math.random() - 0.5) * 0.06;
          node.vy += (Math.random() - 0.5) * 0.06;
        }

        node.x += node.vx;
        node.y += node.vy;

        // Screen boundary rebound
        if (node.x < 10) { node.x = 10; node.vx = Math.abs(node.vx); }
        if (node.x > width - 10) { node.x = width - 10; node.vx = -Math.abs(node.vx); }
        if (node.y < 10) { node.y = 10; node.vy = Math.abs(node.vy); }
        if (node.y > height - 10) { node.y = height - 10; node.vy = -Math.abs(node.vy); }
      }

      // 2. Draw network connections (Mesh Beams)
      for (let i = 0; i < nodes.length; i++) {
        const p1 = nodes[i];

        for (let j = i + 1; j < nodes.length; j++) {
          const p2 = nodes[j];
          const dx = p2.x - p1.x;
          const dy = p2.y - p1.y;
          const distSq = dx * dx + dy * dy;

          if (distSq < maxLinkDistSq) {
            const dist = Math.sqrt(distSq);
            const alpha = (1 - dist / maxLinkDist) * 0.24;

            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = `rgba(25, 211, 230, ${alpha})`;
            ctx.lineWidth = 0.9;
            ctx.stroke();
          }
        }

        // Connect nearby nodes to cursor
        if (mouse.active) {
          const mdx = mouse.x - p1.x;
          const mdy = mouse.y - p1.y;
          const mDistSq = mdx * mdx + mdy * mdy;

          if (mDistSq < maxMouseDistSq) {
            const dist = Math.sqrt(mDistSq);
            const alpha = (1 - dist / maxMouseDist) * 0.45;

            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(mouse.x, mouse.y);
            ctx.strokeStyle = `rgba(92, 141, 255, ${alpha})`;
            ctx.lineWidth = 1.2;
            ctx.stroke();
          }
        }
      }

      // 3. Render and animate live data packets
      for (let i = packets.length - 1; i >= 0; i--) {
        const pkt = packets[i];
        pkt.progress += pkt.speed;

        if (pkt.progress >= 1) {
          packets.splice(i, 1);
          continue;
        }

        const from = nodes[pkt.fromIdx];
        const to = nodes[pkt.toIdx];
        if (!from || !to) {
          packets.splice(i, 1);
          continue;
        }

        const curX = from.x + (to.x - from.x) * pkt.progress;
        const curY = from.y + (to.y - from.y) * pkt.progress;

        ctx.beginPath();
        ctx.arc(curX, curY, 2.2, 0, Math.PI * 2);
        ctx.fillStyle = pkt.color;
        ctx.shadowColor = pkt.color;
        ctx.shadowBlur = 6;
        ctx.fill();
        ctx.shadowBlur = 0;
      }

      // 4. Render node particles & server hubs
      for (let i = 0; i < nodes.length; i++) {
        const node = nodes[i];

        ctx.beginPath();
        ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
        ctx.fillStyle = node.color;
        ctx.globalAlpha = node.baseAlpha;
        ctx.shadowColor = node.color;
        ctx.shadowBlur = node.isHub ? 8 : 3;
        ctx.fill();
        ctx.shadowBlur = 0;
        ctx.globalAlpha = 1;

        if (node.isHub) {
          const ringRad = node.radius + 3.2 + Math.sin(time + node.phase) * 1.4;
          ctx.beginPath();
          ctx.arc(node.x, node.y, ringRad, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(${node.colorRgb}, 0.32)`;
          ctx.lineWidth = 1;
          ctx.stroke();
        }
      }

      // 5. Draw interactive mouse gateway point
      if (mouse.active) {
        ctx.beginPath();
        ctx.arc(mouse.x, mouse.y, 3, 0, Math.PI * 2);
        ctx.fillStyle = '#19D3E6';
        ctx.shadowColor = '#19D3E6';
        ctx.shadowBlur = 10;
        ctx.fill();
        ctx.shadowBlur = 0;

        ctx.beginPath();
        ctx.arc(mouse.x, mouse.y, 7 + Math.sin(time * 2) * 1.5, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(25, 211, 230, 0.4)';
        ctx.lineWidth = 1;
        ctx.stroke();
      }

      if (isVisible && !prefersReducedMotion) {
        animFrameId = requestAnimationFrame(render);
      }
    };

    // Track mouse & touch events
    const onMouseMove = (e: MouseEvent) => {
      const rect = wrapper.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      if (x >= -40 && x <= rect.width + 40 && y >= -40 && y <= rect.height + 40) {
        mouse.x = x;
        mouse.y = y;
        mouse.active = true;
      } else {
        mouse.active = false;
      }
    };

    const onMouseLeave = () => {
      mouse.active = false;
    };

    const onTouchMove = (e: TouchEvent) => {
      if (e.touches.length > 0) {
        const rect = wrapper.getBoundingClientRect();
        mouse.x = e.touches[0].clientX - rect.left;
        mouse.y = e.touches[0].clientY - rect.top;
        mouse.active = true;
      }
    };

    const onTouchEnd = () => {
      mouse.active = false;
    };

    window.addEventListener('mousemove', onMouseMove, { passive: true });
    window.addEventListener('mouseleave', onMouseLeave, { passive: true });
    window.addEventListener('touchmove', onTouchMove, { passive: true });
    window.addEventListener('touchend', onTouchEnd, { passive: true });

    // Pause when offscreen to protect CPU / battery
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (isVisible && !animFrameId && !prefersReducedMotion) {
            animFrameId = requestAnimationFrame(render);
          } else if (!isVisible && animFrameId) {
            cancelAnimationFrame(animFrameId);
            animFrameId = null;
          }
        });
      },
      { threshold: 0.05 }
    );
    observer.observe(wrapper);

    resize();
    window.addEventListener('resize', resize, { passive: true });

    // Initial render
    render();
  }

  // Initialize on load and Astro View Transitions
  initHeroConstellationCanvas();
  document.addEventListener('astro:page-load', initHeroConstellationCanvas);
</script>

<style>
  .hero-deployment-canvas-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    user-select: none;
  }

  .hero-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0.82;
  }

  /* Soft Vignette Mask to keep Hero text perfectly legible */
  .canvas-vignette {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 75% 45%, transparent 35%, rgba(var(--color-bg-0-rgb), 0.7) 85%),
      linear-gradient(to right, rgba(var(--color-bg-0-rgb), 0.94) 0%, rgba(var(--color-bg-0-rgb), 0.45) 45%, rgba(var(--color-bg-0-rgb), 0.25) 100%),
      linear-gradient(to bottom, rgba(var(--color-bg-0-rgb), 0.5) 0%, transparent 20%, transparent 80%, rgba(var(--color-bg-0-rgb), 0.95) 100%);
    pointer-events: none;
    transition: background var(--duration-normal) var(--ease-standard);
  }

  :global([data-theme="light"]) .hero-canvas {
    opacity: 0.55;
  }

  @media (max-width: 768px) {
    .canvas-vignette {
      background: 
        radial-gradient(circle at 50% 30%, transparent 20%, rgba(var(--color-bg-0-rgb), 0.85) 75%),
        linear-gradient(to bottom, rgba(var(--color-bg-0-rgb), 0.85) 0%, rgba(var(--color-bg-0-rgb), 0.3) 30%, rgba(var(--color-bg-0-rgb), 0.9) 100%);
    }
    .hero-canvas {
      opacity: 0.65;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-canvas {
      opacity: 0.35;
    }
  }
</style>
