---
import Icon from '../common/Icon.astro';
import { profileData } from '../../data/profile';

interface MetricMeta {
  shortLabel: string;
  icon: string;
  colorVar: string;
  colorRgb: string;
  subtext: string;
}

const metricConfigs: Record<string, MetricMeta> = {
  cpu: {
    shortLabel: 'CPU LOAD',
    icon: 'cpu',
    colorVar: '#19D3E6',
    colorRgb: '25, 211, 230',
    subtext: '8 Cores Nominal'
  },
  memory: {
    shortLabel: 'MEMORY',
    icon: 'layers',
    colorVar: '#38BDF8',
    colorRgb: '56, 189, 248',
    subtext: 'Dynamic Cache'
  },
  uptime: {
    shortLabel: 'UPTIME SLA',
    icon: 'check-circle',
    colorVar: '#20D39B',
    colorRgb: '32, 211, 155',
    subtext: 'Multi-AZ Active'
  },
  deployments: {
    shortLabel: 'PIPELINES',
    icon: 'zap',
    colorVar: '#A78BFA',
    colorRgb: '167, 139, 250',
    subtext: 'Zero Failure'
  }
};

function generateSparkline(data: number[], width = 120, height = 30, padding = 3) {
  if (!data || data.length === 0) {
    return { path: '', area: '', lastX: 0, lastY: 0 };
  }
  const min = Math.min(...data);
  const max = Math.max(...data);
  const range = (max - min) || 1;

  const points = data.map((val, idx) => {
    const x = Math.round((idx / (data.length - 1)) * width * 10) / 10;
    const y = Math.round((height - padding - ((val - min) / range) * (height - padding * 2)) * 10) / 10;
    return { x, y };
  });

  let pathD = `M ${points[0].x} ${points[0].y}`;
  for (let i = 0; i < points.length - 1; i++) {
    const p0 = points[i];
    const p1 = points[i + 1];
    const midX = Math.round(((p0.x + p1.x) / 2) * 10) / 10;
    pathD += ` C ${midX} ${p0.y}, ${midX} ${p1.y}, ${p1.x} ${p1.y}`;
  }

  const last = points[points.length - 1];
  const areaD = `${pathD} L ${last.x} ${height} L ${points[0].x} ${height} Z`;

  return {
    path: pathD,
    area: areaD,
    lastX: last.x,
    lastY: last.y
  };
}
---

<div class="hero-metrics-strip" data-reveal>
  {profileData.metrics.map((m, index) => {
    const config = metricConfigs[m.id] || {
      shortLabel: m.label,
      icon: 'activity',
      colorVar: '#19D3E6',
      colorRgb: '25, 211, 230',
      subtext: 'Operational'
    };
    const spark = generateSparkline(m.sparkline || [15, 20, 18, 24, 22, 26, 23], 120, 30, 3);

    return (
      <div
        class="telemetry-card"
        title={`${m.label}: ${m.value} : ${m.description}`}
        tabindex="0"
        role="region"
        aria-label={`${m.label}: ${m.value}`}
        style={`--card-accent: ${config.colorVar}; --card-accent-rgb: ${config.colorRgb}; --card-delay: ${index * 60}ms;`}
      >
        <!-- Top Row: Icon + Label + Live Status Dot -->
        <div class="telemetry-header">
          <div class="telemetry-label-group">
            <span class="telemetry-icon" aria-hidden="true">
              <Icon name={config.icon} size={12} />
            </span>
            <span class="telemetry-label font-mono">{config.shortLabel}</span>
          </div>
          <span class="telemetry-live-dot" aria-hidden="true"></span>
        </div>

        <!-- Middle Row: Large Value & Technical Subtext -->
        <div class="telemetry-body">
          <span
            class="telemetry-value font-mono"
            data-counter-target={m.numericTarget}
            data-counter-unit={m.unit}
          >
            {m.value}
          </span>
          <span class="telemetry-subtext font-mono">{config.subtext}</span>
        </div>

        <!-- Bottom Row: Dynamic SVG Sparkline Graph -->
        <div class="telemetry-graph-wrap" aria-hidden="true">
          <svg viewBox="0 0 120 30" class="sparkline-svg" preserveAspectRatio="none">
            <defs>
              <linearGradient id={`spark-grad-${m.id}`} x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color={config.colorVar} stop-opacity="0.32" />
                <stop offset="100%" stop-color={config.colorVar} stop-opacity="0.0" />
              </linearGradient>
            </defs>

            <!-- Gradient Area Fill -->
            <path d={spark.area} fill={`url(#spark-grad-${m.id})`} class="spark-area" />

            <!-- Smooth Stroke Path -->
            <path d={spark.path} fill="none" stroke={config.colorVar} stroke-width="1.8" stroke-linecap="round" class="spark-line" />

            <!-- Latest Data Point Marker -->
            <circle cx={spark.lastX} cy={spark.lastY} r="2.5" fill={config.colorVar} class="spark-dot" />
          </svg>
        </div>
      </div>
    );
  })}
</div>

<style>
  .hero-metrics-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
    margin-top: var(--space-5);
    width: 100%;
    max-width: 580px;
  }

  .telemetry-card {
    background: rgba(13, 22, 34, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 10px 10px 4px 10px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    cursor: default;
    user-select: none;
    outline: none;
    transition: 
      transform var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  :global([data-theme="light"]) .telemetry-card {
    background: #0d162205;
    border-color: rgba(209, 217, 226, 0.75);
    box-shadow: 0 2px 8px #0000000a;
  }

  .telemetry-card:hover,
  .telemetry-card:focus-visible {
    transform: translateY(-2px);
    border-color: var(--card-accent);
    background: rgba(18, 30, 46, 0.92);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 14px rgba(var(--card-accent-rgb), 0.2);
  }

  :global([data-theme="light"]) .telemetry-card:hover,
  :global([data-theme="light"]) .telemetry-card:focus-visible {
    background: #0d16220d;
    box-shadow: 0 4px 14px #00000012, 0 0 10px rgba(var(--card-accent-rgb), 0.15);
  }

  .telemetry-card:focus-visible {
    outline: 2px solid var(--card-accent);
    outline-offset: 2px;
  }

  .telemetry-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    margin-bottom: 2px;
  }

  .telemetry-label-group {
    display: flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
  }

  .telemetry-icon {
    color: var(--card-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.9;
    flex-shrink: 0;
  }

  .telemetry-label {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .telemetry-live-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--card-accent);
    box-shadow: 0 0 5px var(--card-accent);
    flex-shrink: 0;
  }

  .telemetry-body {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin-top: 1px;
    margin-bottom: 2px;
  }

  .telemetry-value {
    font-size: 1.18rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .telemetry-subtext {
    font-size: 0.58rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .telemetry-graph-wrap {
    width: 100%;
    height: 28px;
    position: relative;
    margin-top: 2px;
  }

  .sparkline-svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .spark-line {
    transition: stroke-width var(--duration-fast), filter var(--duration-fast);
  }

  .telemetry-card:hover .spark-line {
    stroke-width: 2.2;
    filter: drop-shadow(0 0 4px var(--card-accent));
  }

  .spark-dot {
    filter: drop-shadow(0 0 3px var(--card-accent));
    transition: r var(--duration-fast);
  }

  .telemetry-card:hover .spark-dot {
    r: 3.2;
  }

  @media (max-width: 640px) {
    .hero-metrics-strip {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      margin-top: var(--space-4);
      max-width: 100%;
    }

    .telemetry-card {
      padding: 10px 12px 6px 12px;
    }

    .telemetry-value {
      font-size: 1.12rem;
    }

    .telemetry-label {
      font-size: 0.62rem;
    }
  }

  @media (max-width: 360px) {
    .telemetry-value {
      font-size: 1rem;
    }

    .telemetry-label {
      font-size: 0.56rem;
    }

    .telemetry-subtext {
      font-size: 0.54rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .telemetry-card:hover {
      transform: none !important;
    }
    .spark-line {
      transition: none !important;
    }
  }
</style>
