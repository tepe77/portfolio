---
import Icon from '../common/Icon.astro';
import InfrastructureNode from './InfrastructureNode.astro';
---

<div id="infrastructure-topology" class="topology-container" data-reveal>
  <!-- Topology Interactive Control Bar -->
  <div class="topology-toolbar">
    <div class="toolbar-main">
      <div class="toolbar-brand">
        <span class="toolbar-title font-mono">CLUSTER TOPOLOGY // MULTI-TIER HA ARCHITECTURE</span>
        <span class="badge-live font-mono text-xs">● LIVE TOPOLOGY</span>
      </div>

      <!-- Filter Buttons -->
      <div class="topology-filters" role="tablist" aria-label="Filter Topology Views">
        <button type="button" class="filter-btn active font-mono text-xs" data-topo-filter="all">
          ALL NODES
        </button>
        <button type="button" class="filter-btn font-mono text-xs" data-topo-filter="ingress">
          INGRESS &amp; APPS
        </button>
        <button type="button" class="filter-btn font-mono text-xs" data-topo-filter="database">
          DATABASE HA (3-NODE)
        </button>
        <button type="button" class="filter-btn font-mono text-xs" data-topo-filter="observability">
          OBSERVABILITY
        </button>
      </div>
    </div>

    <!-- Interactive Simulation Actions -->
    <div class="toolbar-actions">
      <button
        type="button"
        id="btn-simulate-failover"
        class="action-btn action-failover font-mono text-xs"
        aria-label="Simulate Patroni high availability failover drill"
      >
        <Icon name="refresh" size={14} />
        <span>SIMULATE FAILOVER DRILL</span>
      </button>

      <button
        type="button"
        id="btn-health-ping"
        class="action-btn action-ping font-mono text-xs"
        aria-label="Send cluster heartbeat health ping"
      >
        <Icon name="activity" size={14} />
        <span>HEALTH PING</span>
      </button>
    </div>
  </div>

  <!-- Real-time Simulation Alert Banner -->
  <div id="topology-drill-banner" class="drill-banner font-mono text-xs" aria-live="polite">
    <span class="drill-icon">⚡</span>
    <span id="topology-drill-text">Initializing cluster state...</span>
  </div>

  <div class="topology-stage">
    <!-- Desktop Interactive SVG Network Canvas (1460 x 1260) -->
    <div class="desktop-graph-canvas">
      <svg class="graph-svg" viewBox="0 0 1460 1260" preserveAspectRatio="xMidYMid meet">
        <defs>
          <linearGradient id="flow-primary" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#19D3E6" stop-opacity="0.9" />
            <stop offset="100%" stop-color="#5C8DFF" stop-opacity="0.9" />
          </linearGradient>
          <linearGradient id="flow-db" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#19D3E6" stop-opacity="0.9" />
            <stop offset="100%" stop-color="#20D39B" stop-opacity="0.9" />
          </linearGradient>
          <linearGradient id="flow-sync" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#20D39B" stop-opacity="0.9" />
            <stop offset="100%" stop-color="#5C8DFF" stop-opacity="0.9" />
          </linearGradient>
          <linearGradient id="flow-obs" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#5C8DFF" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#F5B942" stop-opacity="0.8" />
          </linearGradient>
        </defs>

        <!-- 1. Internet to Nginx (Clean vertical route) -->
        <line x1="730" y1="156" x2="730" y2="240" stroke="url(#flow-primary)" stroke-width="2.5" stroke-dasharray="6 6" class="topo-line animate-flow" data-from="internet" data-to="nginx" />

        <!-- 2. Nginx to App-01 and App-02 -->
        <path d="M 730 346 L 730 395 L 550 395 L 550 445" stroke="url(#flow-primary)" stroke-width="2.5" stroke-dasharray="6 6" class="topo-line animate-flow" data-from="nginx" data-to="app-01" fill="none" />
        <path d="M 730 346 L 730 395 L 910 395 L 910 445" stroke="url(#flow-primary)" stroke-width="2.5" stroke-dasharray="6 6" class="topo-line animate-flow" data-from="nginx" data-to="app-02" fill="none" />

        <!-- 3. App Nodes to Redis (Horizontal connection) -->
        <line x1="445" y1="498" x2="295" y2="498" stroke="url(#flow-primary)" stroke-width="2" stroke-dasharray="5 5" class="topo-line animate-flow" data-from="app-01" data-to="redis" />
        <path d="M 805 520 L 730 520 L 730 580 L 190 580 L 190 551" stroke="url(#flow-primary)" stroke-width="1.5" stroke-dasharray="4 4" class="topo-line" data-from="app-02" data-to="redis" fill="none" />

        <!-- 4. App Nodes to Prometheus Telemetry (Horizontal connection) -->
        <line x1="1015" y1="498" x2="1165" y2="498" stroke="url(#flow-obs)" stroke-width="2" stroke-dasharray="5 5" class="topo-line" data-from="app-02" data-to="prometheus" />
        <path d="M 655 520 L 730 520 L 730 580 L 1270 580 L 1270 551" stroke="url(#flow-obs)" stroke-width="1.5" stroke-dasharray="4 4" class="topo-line" data-from="app-01" data-to="prometheus" fill="none" />

        <!-- 5. App Nodes to PgBouncer -->
        <path d="M 550 551 L 550 600 L 730 600 L 730 650" stroke="url(#flow-primary)" stroke-width="2.5" stroke-dasharray="6 6" class="topo-line animate-flow" data-from="app-01" data-to="pgbouncer" fill="none" />
        <path d="M 910 551 L 910 600 L 730 600 L 730 650" stroke="url(#flow-primary)" stroke-width="2.5" stroke-dasharray="6 6" class="topo-line animate-flow" data-from="app-02" data-to="pgbouncer" fill="none" />

        <!-- 6. PgBouncer to Patroni Leader Node (Patroni-01) -->
        <path d="M 730 756 L 730 805 L 210 805 L 210 855" stroke="url(#flow-db)" stroke-width="3" stroke-dasharray="6 6" class="topo-line animate-flow" data-from="pgbouncer" data-to="patroni-01" fill="none" />

        <!-- 7. Patroni HA Replication Bus (Patroni 01 -> Patroni 02 and 03) -->
        <!-- Patroni 01 to Patroni 02 Sync Replication -->
        <line x1="315" y1="908" x2="460" y2="908" stroke="url(#flow-sync)" stroke-width="2.5" stroke-dasharray="4 4" class="topo-line animate-flow" data-from="patroni-01" data-to="patroni-02" />
        <!-- Patroni 01 to Patroni 03 Async Replication -->
        <path d="M 315 930 L 385 930 L 385 990 L 745 990 L 745 930 L 815 930" stroke="url(#flow-sync)" stroke-width="2" stroke-dasharray="4 4" class="topo-line animate-flow" data-from="patroni-01" data-to="patroni-03" fill="none" />

        <!-- 8. Patroni Nodes to etcd Raft DCS Ring -->
        <line x1="1025" y1="908" x2="1165" y2="908" stroke="#F5B942" stroke-width="2" stroke-dasharray="4 4" class="topo-line" data-from="patroni-03" data-to="etcd-dcs" />
        <path d="M 670 885 L 740 885 L 740 820 L 1220 820 L 1220 855" stroke="#F5B942" stroke-width="1.5" stroke-dasharray="4 4" class="topo-line" data-from="patroni-02" data-to="etcd-dcs" fill="none" />
        <path d="M 315 885 L 385 885 L 385 810 L 1270 810 L 1270 855" stroke="#F5B942" stroke-width="1.5" stroke-dasharray="4 4" class="topo-line" data-from="patroni-01" data-to="etcd-dcs" fill="none" />

        <!-- 9. Patroni-01 to Object Storage (WAL-G backup) - Clean vertical -->
        <line x1="210" y1="961" x2="210" y2="1060" stroke="url(#flow-primary)" stroke-width="2" stroke-dasharray="5 5" class="topo-line" data-from="patroni-01" data-to="object-storage" />

        <!-- 10. Prometheus to Grafana Dashboard - Clean vertical -->
        <line x1="1270" y1="551" x2="1270" y2="1060" stroke="url(#flow-obs)" stroke-width="2" stroke-dasharray="5 5" class="topo-line" data-from="prometheus" data-to="grafana" />
      </svg>

      <!-- Tier 1: Ingress / Edge (y: 50px) -->
      <InfrastructureNode
        id="internet"
        name="PUBLIC INGRESS"
        subtitle="Cloudflare CDN & WAF"
        icon="globe"
        status="operational"
        badge="EDGE"
        port=":443 HTTPS"
        connections={["nginx"]}
        top="50px"
        left="calc(50% - 105px)"
      />

      <!-- Tier 2: Ingress Gateway (y: 240px) -->
      <InfrastructureNode
        id="nginx"
        name="NGINX INGRESS PROXY"
        subtitle="Reverse Proxy & TLS Auto"
        icon="server"
        status="operational"
        badge="GATEWAY"
        port=":443 / :80"
        connections={["internet", "app-01", "app-02"]}
        top="240px"
        left="calc(50% - 105px)"
      />

      <!-- Tier 3: Compute, Caching & Observability (y: 445px) -->
      <InfrastructureNode
        id="redis"
        name="REDIS CACHE"
        subtitle="Broker & Session Store"
        icon="layers"
        status="healthy"
        badge="IN-MEMORY"
        port=":6379 TCP"
        connections={["app-01", "app-02"]}
        top="445px"
        left="85px"
      />

      <InfrastructureNode
        id="app-01"
        name="APP NODE 01"
        subtitle="Docker Swarm Worker"
        icon="docker"
        status="healthy"
        badge="COMPUTE"
        port=":8080 TCP"
        connections={["nginx", "pgbouncer", "redis", "prometheus"]}
        top="445px"
        left="445px"
      />

      <InfrastructureNode
        id="app-02"
        name="APP NODE 02"
        subtitle="Docker Swarm Worker"
        icon="docker"
        status="healthy"
        badge="COMPUTE"
        port=":8080 TCP"
        connections={["nginx", "pgbouncer", "redis", "prometheus"]}
        top="445px"
        left="805px"
      />

      <InfrastructureNode
        id="prometheus"
        name="PROMETHEUS TSDB"
        subtitle="Telemetry & Metrics Scraper"
        icon="activity"
        status="active"
        badge="SCRAPER"
        port=":9090 TCP"
        connections={["grafana", "app-01", "app-02", "patroni-01"]}
        top="445px"
        left="1165px"
      />

      <!-- Tier 4: Connection Pooler (y: 650px) -->
      <InfrastructureNode
        id="pgbouncer"
        name="PGBOUNCER POOL"
        subtitle="Transaction Connection Pool"
        icon="refresh"
        status="healthy"
        badge="POOLER"
        port=":6432 TCP"
        connections={["app-01", "app-02", "patroni-01"]}
        top="650px"
        left="calc(50% - 105px)"
      />

      <!-- Tier 5: 3-Node PostgreSQL HA Cluster & etcd (y: 855px) -->
      <InfrastructureNode
        id="patroni-01"
        name="PATRONI-01 (LEADER)"
        subtitle="Primary PostgreSQL Master"
        icon="database"
        status="healthy"
        badge="MASTER"
        port=":5432 RW"
        connections={["pgbouncer", "patroni-02", "patroni-03", "etcd-dcs", "object-storage", "prometheus"]}
        top="855px"
        left="105px"
      />

      <InfrastructureNode
        id="patroni-02"
        name="PATRONI-02 (STANDBY)"
        subtitle="Synchronous Read Replica"
        icon="database"
        status="standby"
        badge="SYNC"
        port=":5432 RO"
        connections={["patroni-01", "etcd-dcs"]}
        top="855px"
        left="460px"
      />

      <InfrastructureNode
        id="patroni-03"
        name="PATRONI-03 (STANDBY)"
        subtitle="Asynchronous Read Replica"
        icon="database"
        status="standby"
        badge="ASYNC"
        port=":5432 RO"
        connections={["patroni-01", "etcd-dcs"]}
        top="855px"
        left="815px"
      />

      <InfrastructureNode
        id="etcd-dcs"
        name="ETCD RAFT DCS"
        subtitle="Distributed Consensus Ring"
        icon="network"
        status="active"
        badge="DCS"
        port=":2379 QUORUM"
        connections={["patroni-01", "patroni-02", "patroni-03"]}
        top="855px"
        left="1165px"
      />

      <!-- Tier 6: Storage & Dashboards (y: 1060px) -->
      <InfrastructureNode
        id="object-storage"
        name="ENCRYPTED S3"
        subtitle="WAL-G Backups & Snapshots"
        icon="cloud"
        status="healthy"
        badge="STORAGE"
        port=":9000 S3"
        connections={["patroni-01"]}
        top="1060px"
        left="105px"
      />

      <InfrastructureNode
        id="grafana"
        name="GRAFANA METRICS"
        subtitle="Operational Dashboards"
        icon="chart"
        status="active"
        badge="DASHBOARD"
        port=":3000 HTTP"
        connections={["prometheus"]}
        top="1060px"
        left="1165px"
      />
    </div>

    <!-- Mobile Vertical Topology Flow (< 1100px) -->
    <div class="mobile-topology-flow">
      <div class="mobile-tier-section">
        <span class="mobile-tier-title font-mono text-xs text-cyan">TIER 01 // PUBLIC INGRESS</span>
        <InfrastructureNode id="internet" name="PUBLIC INGRESS" subtitle="Cloudflare CDN & WAF" icon="globe" status="operational" badge="EDGE" port=":443 HTTPS" connections={["nginx"]} />
      </div>
      <div class="mobile-flow-connector" aria-hidden="true">&darr;</div>

      <div class="mobile-tier-section">
        <span class="mobile-tier-title font-mono text-xs text-cyan">TIER 02 // INGRESS GATEWAY</span>
        <InfrastructureNode id="nginx" name="NGINX PROXY" subtitle="Reverse Proxy & TLS Auto" icon="server" status="operational" badge="GATEWAY" port=":443 / :80" connections={["app-01", "app-02"]} />
      </div>
      <div class="mobile-flow-connector" aria-hidden="true">&darr;</div>

      <div class="mobile-tier-section">
        <span class="mobile-tier-title font-mono text-xs text-cyan">TIER 03 // COMPUTE &amp; CACHE</span>
        <div class="mobile-nodes-grid">
          <InfrastructureNode id="app-01" name="APP NODE 01" subtitle="Docker Swarm" icon="docker" status="healthy" badge="COMPUTE" port=":8080" connections={["pgbouncer", "redis"]} />
          <InfrastructureNode id="app-02" name="APP NODE 02" subtitle="Docker Swarm" icon="docker" status="healthy" badge="COMPUTE" port=":8080" connections={["pgbouncer", "redis"]} />
        </div>
        <div class="mobile-nodes-grid" style="margin-top: var(--space-4);">
          <InfrastructureNode id="redis" name="REDIS CACHE" subtitle="In-Memory Broker" icon="layers" status="healthy" badge="CACHE" port=":6379" connections={["app-01"]} />
          <InfrastructureNode id="prometheus" name="PROMETHEUS TSDB" subtitle="Telemetry Engine" icon="activity" status="active" badge="METRICS" port=":9090" connections={["grafana"]} />
        </div>
      </div>
      <div class="mobile-flow-connector" aria-hidden="true">&darr;</div>

      <div class="mobile-tier-section">
        <span class="mobile-tier-title font-mono text-xs text-cyan">TIER 04 // CONNECTION POOL</span>
        <InfrastructureNode id="pgbouncer" name="PGBOUNCER" subtitle="Transaction Pooling" icon="refresh" status="healthy" badge="POOLER" port=":6432" connections={["patroni-01"]} />
      </div>
      <div class="mobile-flow-connector" aria-hidden="true">&darr;</div>

      <div class="mobile-tier-section">
        <span class="mobile-tier-title font-mono text-xs text-cyan">TIER 05 // PATRONI 3-NODE HA CLUSTER &amp; ETCD</span>
        <div class="mobile-nodes-grid">
          <InfrastructureNode id="patroni-01" name="PATRONI-01" subtitle="Primary Master (RW)" icon="database" status="healthy" badge="LEADER" port=":5432" connections={["patroni-02", "etcd-dcs"]} />
          <InfrastructureNode id="patroni-02" name="PATRONI-02" subtitle="Synchronous Replica" icon="database" status="standby" badge="SYNC" port=":5432" connections={["etcd-dcs"]} />
        </div>
        <div class="mobile-nodes-grid" style="margin-top: var(--space-4);">
          <InfrastructureNode id="patroni-03" name="PATRONI-03" subtitle="Asynchronous Replica" icon="database" status="standby" badge="ASYNC" port=":5432" connections={["etcd-dcs"]} />
          <InfrastructureNode id="etcd-dcs" name="ETCD DCS" subtitle="Raft Consensus (3/3)" icon="network" status="active" badge="DCS" port=":2379" connections={["patroni-01"]} />
        </div>
      </div>
      <div class="mobile-flow-connector" aria-hidden="true">&darr;</div>

      <div class="mobile-tier-section">
        <span class="mobile-tier-title font-mono text-xs text-cyan">TIER 06 // STORAGE &amp; DASHBOARDS</span>
        <div class="mobile-nodes-grid">
          <InfrastructureNode id="object-storage" name="S3 STORAGE" subtitle="WAL-G Backups" icon="cloud" status="healthy" badge="STORAGE" port=":9000" connections={["patroni-01"]} />
          <InfrastructureNode id="grafana" name="GRAFANA UI" subtitle="Telemetry Dashboards" icon="chart" status="active" badge="UI" port=":3000" connections={["prometheus"]} />
        </div>
      </div>
    </div>

    <!-- Inspector Sidepanel / Drawer HUD -->
    <aside id="topology-details-panel" class="topology-details-panel" aria-label="Service Details Inspector" aria-hidden="true">
      <div class="panel-header">
        <div>
          <span id="topology-detail-category" class="panel-category font-mono text-xs">TIER // CATEGORY</span>
          <h3 id="topology-detail-title" class="panel-title">Service Details</h3>
        </div>
        <button type="button" id="topology-detail-close" class="panel-close-btn" aria-label="Close service details">
          <Icon name="close" size={20} />
        </button>
      </div>

      <div class="panel-body">
        <!-- Telemetry HUD Grid -->
        <div class="panel-telemetry-hud">
          <div class="hud-item font-mono">
            <span class="hud-lbl">BIND PORT</span>
            <span id="topology-detail-port" class="hud-val text-cyan">:443</span>
          </div>
          <div class="hud-item font-mono">
            <span class="hud-lbl">SUBNET</span>
            <span id="topology-detail-subnet" class="hud-val">10.244.0.0/24</span>
          </div>
          <div class="hud-item font-mono">
            <span class="hud-lbl">LATENCY</span>
            <span id="topology-detail-latency" class="hud-val text-green">0.8ms</span>
          </div>
          <div class="hud-item font-mono">
            <span class="hud-lbl">ACTIVE CONNS</span>
            <span id="topology-detail-conns" class="hud-val">1,240 pool</span>
          </div>
          <div class="hud-item font-mono">
            <span class="hud-lbl">THROUGHPUT</span>
            <span id="topology-detail-throughput" class="hud-val">8.6 MB/s</span>
          </div>
          <div id="topology-detail-lag-row" class="hud-item font-mono" style="display: none;">
            <span class="hud-lbl">REPLICA LAG</span>
            <span id="topology-detail-lag" class="hud-val text-green">0 bytes</span>
          </div>
        </div>

        <div class="panel-section">
          <span class="panel-section-label font-mono">FUNCTION &amp; ROLE</span>
          <p id="topology-detail-desc" class="panel-text"></p>
        </div>

        <div class="panel-section">
          <span class="panel-section-label font-mono">ARCHITECTURE IMPLEMENTATION</span>
          <p id="topology-detail-arch" class="panel-arch font-mono"></p>
        </div>

        <div class="panel-section">
          <span class="panel-section-label font-mono">ENGINEERING CONTROLS</span>
          <div id="topology-detail-tech" class="panel-tags"></div>
        </div>
      </div>

      <div class="panel-footer">
        <a href="#projects" class="panel-cta font-mono">
          VIEW ASSOCIATED CASE STUDIES &rarr;
        </a>
      </div>
    </aside>
  </div>
</div>

<style>
  .topology-container {
    background: var(--color-bg-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md), 0 0 60px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .topology-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    background: var(--color-surface-1);
    border-bottom: 1px solid var(--color-border);
  }

  .toolbar-main {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .toolbar-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .toolbar-title {
    color: var(--color-text-primary);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .badge-live {
    color: var(--color-success);
    background: rgba(32, 211, 155, 0.1);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(32, 211, 155, 0.3);
  }

  .topology-filters {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .filter-btn {
    background: var(--color-bg-0);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    padding: 5px 12px;
    cursor: pointer;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: all var(--duration-fast);
  }

  .filter-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-hover);
  }

  .filter-btn.active {
    background: var(--color-surface-2);
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
    box-shadow: 0 0 12px rgba(25, 211, 230, 0.2);
  }

  .toolbar-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-weight: 700;
    transition: all var(--duration-fast);
  }

  .action-failover {
    background: rgba(245, 185, 66, 0.12);
    border: 1px solid rgba(245, 185, 66, 0.4);
    color: var(--color-warning);
  }

  .action-failover:hover {
    background: var(--color-warning);
    color: var(--color-bg-0);
    box-shadow: 0 0 16px rgba(245, 185, 66, 0.4);
  }

  .action-ping {
    background: rgba(25, 211, 230, 0.1);
    border: 1px solid var(--color-border);
    color: var(--color-accent-primary);
  }

  .action-ping:hover {
    background: var(--color-surface-2);
    border-color: var(--color-border-hover);
  }

  /* Drill Banner */
  .drill-banner {
    display: none;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: rgba(245, 185, 66, 0.15);
    border-bottom: 1px solid var(--color-warning);
    color: var(--color-warning);
    animation: pulse-dot-warning 2s infinite;
  }

  .drill-banner.active {
    display: flex;
  }

  .topology-stage {
    position: relative;
    min-height: 1260px;
    background: 
