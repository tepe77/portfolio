---
---

<div id="terminal-container" class="terminal-window blueprint-crosshair" data-reveal>
  <div class="terminal-bar">
    <div class="terminal-bar-left">
      <div class="terminal-controls" aria-hidden="true">
        <span class="control-dot dot-close" title="Close"></span>
        <span class="control-dot dot-min" title="Minimize"></span>
        <span class="control-dot dot-max" title="Maximize"></span>
      </div>
      <div class="terminal-tabs-strip font-mono" role="tablist">
        <div class="terminal-tab active" role="tab" aria-selected="true">
          <span class="tab-shell-glyph">zsh</span>
          <span class="tab-title-text">~ (edge-node)</span>
          <span class="tab-status-ping" title="RTT heartbeat"><span class="ping-pulse"></span>0.8ms</span>
        </div>
        <div class="terminal-tab inactive" role="tab" aria-selected="false">
          <span class="tab-shell-glyph">log</span>
          <span class="tab-title-text">cluster.events</span>
        </div>
      </div>
    </div>
    <div class="terminal-badge font-mono text-xs">
      <span class="badge-live-pulse" aria-hidden="true"></span>
      <span>TTY_ONLINE</span>
    </div>
  </div>

  <div class="terminal-content font-mono">
    <div id="terminal-output" class="terminal-output">
      <div class="terminal-line terminal-dim"># Initializing interactive console session...</div>
      <div class="terminal-line terminal-dim"># Type "help" to see available simulation commands.</div>
      <div class="terminal-line terminal-command">prasaswo@portfolio:~$ cat profile.yaml</div>
      <div class="terminal-line terminal-yaml">
        <span class="yaml-key">name:</span> <span class="yaml-val">Prasaswo Tepe</span>
      </div>
      <div class="terminal-line terminal-yaml">
        <span class="yaml-key">role:</span> <span class="yaml-val">DevOps &amp; Infrastructure Engineer</span>
      </div>
      <div class="terminal-line terminal-yaml">
        <span class="yaml-key">specialization:</span>
      </div>
      <div class="terminal-line terminal-yaml">
        &nbsp;&nbsp;- <span class="yaml-val">Container Orchestration (Docker)</span>
      </div>
      <div class="terminal-line terminal-yaml">
        &nbsp;&nbsp;- <span class="yaml-val">Automated Delivery (GitLab CI/CD)</span>
      </div>
      <div class="terminal-line terminal-yaml">
        &nbsp;&nbsp;- <span class="yaml-val">Database HA Clustering (Patroni + etcd)</span>
      </div>
      <div class="terminal-line terminal-yaml">
        &nbsp;&nbsp;- <span class="yaml-val">Observability (Prometheus + Grafana)</span>
      </div>
      <div class="terminal-line terminal-yaml">
        <span class="yaml-key">philosophy:</span> <span class="yaml-string">"Automate the repeatable. Observe the critical. Expect failure."</span>
      </div>
      <div class="terminal-line terminal-success">● System status: All nodes operational. Ready for input.</div>
    </div>

    <!-- Quick Command Chips for Mobile / Fast Touch -->
    <div class="terminal-quick-chips font-mono text-xs" aria-label="Quick terminal commands">
      <span class="quick-chips-lbl">QUICK:</span>
      <button type="button" class="terminal-chip" data-cmd="help">help</button>
      <button type="button" class="terminal-chip" data-cmd="cluster">cluster</button>
      <button type="button" class="terminal-chip" data-cmd="skills">skills</button>
      <button type="button" class="terminal-chip" data-cmd="contact">contact</button>
      <button type="button" class="terminal-chip" data-cmd="clear">clear</button>
    </div>

    <!-- Active Input Line -->
    <div class="terminal-input-row">
      <label for="terminal-input" class="terminal-prompt">prasaswo@portfolio:~$</label>
      <input
        type="text"
        id="terminal-input"
        class="terminal-input font-mono"
        autocomplete="off"
        spellcheck="false"
        aria-label="Terminal command input. Type help for commands."
      />
    </div>
  </div>
</div>

<style>
  .terminal-window {
    background: var(--color-bg-0);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md), 0 0 32px rgba(25, 211, 230, 0.05);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 420px;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-4);
    height: 38px;
    background: var(--color-surface-1);
    border-bottom: 1px solid var(--color-border);
    gap: var(--space-3);
  }

  .terminal-bar-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 100%;
  }

  .terminal-controls {
    display: flex;
    gap: 6px;
    margin-right: 4px;
  }

  .control-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    transition: transform var(--duration-fast);
  }

  .control-dot:hover {
    transform: scale(1.15);
  }

  .dot-close { background: #F05D6C; }
  .dot-min { background: #F5B942; }
  .dot-max { background: #20D39B; }

  .terminal-tabs-strip {
    display: flex;
    align-items: flex-end;
    height: 100%;
    gap: 4px;
  }

  .terminal-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 10px;
    height: 30px;
    font-size: 0.68rem;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    transition: all var(--duration-fast);
    cursor: default;
    user-select: none;
  }

  .terminal-tab.active {
    background: var(--color-bg-0);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-bottom: none;
    font-weight: 600;
  }

  .terminal-tab.inactive {
    color: var(--color-text-muted);
    opacity: 0.6;
  }

  .tab-shell-glyph {
    color: var(--color-accent-primary);
    font-weight: 700;
    font-size: 0.65rem;
  }

  .tab-status-ping {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.58rem;
    color: var(--color-success);
    background: rgba(32, 211, 155, 0.1);
    padding: 1px 5px;
    border-radius: 3px;
  }

  .ping-pulse {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 5px var(--color-success);
  }

  .badge-live-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-primary);
    box-shadow: 0 0 6px var(--color-accent-primary);
    display: inline-block;
  }

  .terminal-badge {
    color: var(--color-accent-primary);
    font-size: 0.62rem;
    font-weight: 700;
    padding: 2px 7px;
    background: rgba(25, 211, 230, 0.1);
    border: 1px solid rgba(25, 211, 230, 0.2);
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    letter-spacing: 0.05em;
  }

  .terminal-content {
    padding: var(--space-4) var(--space-5);
    flex: 1;
    display: flex;
    flex-direction: column;
    font-size: 0.8125rem;
    line-height: 1.6;
    overflow-y: auto;
    cursor: text;
  }

  .terminal-output {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: var(--space-3);
  }

  :global(.terminal-line) {
    word-break: break-word;
  }

  :global(.terminal-dim) {
    color: var(--color-text-muted);
  }

  :global(.terminal-command) {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  :global(.terminal-success) {
    color: var(--color-success);
    margin-top: var(--space-1);
  }

  :global(.terminal-error) {
    color: var(--color-danger);
  }

  :global(.terminal-response) {
    color: var(--color-text-secondary);
  }

  .yaml-key {
    color: var(--color-accent-primary);
    font-weight: 600;
  }

  .yaml-val {
    color: var(--color-text-primary);
  }

  .terminal-quick-chips {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    border-top: 1px dashed rgba(27, 48, 66, 0.6);
    margin-top: auto;
    margin-bottom: var(--space-2);
  }

  .quick-chips-lbl {
    color: var(--color-text-muted);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
  }

  .terminal-chip {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-accent-primary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 2px 7px;
    cursor: pointer;
    transition: all var(--duration-fast);
    outline: none;
    user-select: none;
  }

  .terminal-chip:hover,
  .terminal-chip:focus-visible {
    background: rgba(25, 211, 230, 0.12);
    border-color: var(--color-accent-primary);
    color: #FFFFFF;
    box-shadow: 0 0 10px rgba(25, 211, 230, 0.25);
  }

  .terminal-chip:active {
    transform: scale(0.96);
  }

  .terminal-input-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .terminal-prompt {
    color: var(--color-accent-primary);
    font-weight: 700;
    white-space: nowrap;
    font-size: 0.8125rem;
  }

  .terminal-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text-primary);
    font-size: 0.8125rem;
    caret-color: var(--color-accent-primary);
  }

  @media (max-width: 768px) {
    .terminal-content {
      padding: var(--space-3) var(--space-4);
      font-size: 0.75rem;
    }

    .terminal-prompt {
      font-size: 0.75rem;
    }

    .terminal-input {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .terminal-content {
      padding: var(--space-3) var(--space-3);
      font-size: 0.7rem;
      line-height: 1.5;
    }

    .terminal-prompt {
      font-size: 0.7rem;
    }

    .terminal-input {
      font-size: 0.7rem;
    }

    .terminal-chip {
      padding: 3px 6px;
      font-size: 0.62rem;
    }

    .quick-chips-lbl {
      font-size: 0.6rem;
    }
  }

  /* Light Mode Specific Overrides */
  :global([data-theme="light"]) .terminal-window {
    background: #FFFFFF;
    border-color: rgba(209, 217, 226, 0.75);
    box-shadow: 0 16px 40px #00000012, 0 2px 8px #00000008;
  }

  :global([data-theme="light"]) .terminal-bar {
    background: #f0f0f0;
    border-bottom-color: rgba(209, 217, 226, 0.75);
  }

  :global([data-theme="light"]) .terminal-chip {
    background: #f0f0f0;
    border-color: rgba(209, 217, 226, 0.7);
  }

  :global([data-theme="light"]) .terminal-tab.active {
    background: #FFFFFF;
    border-color: rgba(209, 217, 226, 0.85);
    color: var(--color-text-primary);
  }
</style>
